package-as: Hekili

enable-nolib-creation: no

# The nine addons live in src/; move them to the zip root (src/Hekili replaces the package folder itself, so
# root files such as the licence do not survive: the copy in src/Hekili/ is the shipped one, beside the wowsims/forever
# MIT notice that covers the class packs' translated (wowsims.com) priorities).
move-folders:
    Hekili/src/Hekili: Hekili
    Hekili/src/Hekili_Shared: Hekili_Shared
    Hekili/src/Hekili_Druid: Hekili_Druid
    Hekili/src/Hekili_Warrior: Hekili_Warrior
    Hekili/src/Hekili_Rogue: Hekili_Rogue
    Hekili/src/Hekili_Paladin: Hekili_Paladin
    Hekili/src/Hekili_Shaman: Hekili_Shaman
    Hekili/src/Hekili_Hunter: Hekili_Hunter
    Hekili/src/Hekili_Mage: Hekili_Mage

# The packager uploads nothing (release.yml passes -d; publish.yml uploads with the release body as the changelog).
# manual-changelog stays so the packager does not generate a CHANGELOG.md into the shipped Hekili/ folder.
manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown

ignore:
    - README.md
    - CHANGELOG.md
    - src/Hekili_Shared/README.md
    - tests
    - tools
    - docs
    - scripts
    - archive
    - .superpowers
    - .github
    - .busted
    - .luacheckrc
    - .luarc.json
    - .stylua.toml
    - .styluaignore
    - Makefile
    - mise.toml
    - src/Hekili_Warrior/APLs
    - src/Hekili_Druid/APLs
    - src/Hekili_Rogue/APLs
    - src/Hekili_Paladin/APLs
    - src/Hekili_Shaman/APLs
    - src/Hekili_Hunter/APLs
