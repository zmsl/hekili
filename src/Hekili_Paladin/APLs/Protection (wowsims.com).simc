# Omitted: default #1: autocastOtherCooldowns: unmapped item 19024
# Omitted: default #1: autocastOtherCooldowns: unmapped item 272440
# Omitted: default #5: hidden

actions.precombat=righteous_fury,if=!buff.righteous_fury.up
actions.precombat+=/retribution_aura,if=!buff.retribution_aura.up
actions.precombat+=/seal_of_the_crusader,if=!buff.seal_of_the_crusader.up
actions=stoneform
actions+=/templars_bulwark,use_off_gcd=1
actions+=/judgement,use_off_gcd=1
actions+=/swift_judgement,use_off_gcd=1,if=(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0))
actions+=/seal_of_fury,focus=2,if=(buff.seal_of_fury.remains<mainhand_remains&!buff.seal_of_fury.up)
actions+=/consecration
actions+=/holy_shock,if=(!talent.consecrated_ground.enabled|debuff.consecrated_ground.up)
actions+=/holy_shield,focus=2
actions+=/holy_strike
actions+=/exorcism
