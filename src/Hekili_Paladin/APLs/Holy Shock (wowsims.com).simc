# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/paladin_holy_shock.lua: edit that recipe, not this file.
# Deviation: default #6: targetIsMobType is the request's target type (mechanical); the client's creature type is not read.
# Omitted: precombat #2: itemSwap
# Omitted: precombat #3: move
# Omitted: precombat #4: never
# Omitted: default #2: autocastOtherCooldowns: none in the log
# Omitted: cast_selected_seal #2: never
# Omitted: move_to_melee #1: sequence move_to_melee of groupReference
# Omitted: move_to_melee #2: never
# Omitted: mcp_swap #1: itemSwap
# Omitted: mcp_swap #2: itemSwap
# Omitted: default: empty group move_to_melee
# Omitted: default: empty group mcp_swap

actions.precombat=call_action_list,name=activate_assigned_aura
actions.precombat+=/call_action_list,name=cast_assigned_judgement
actions=judgement,use_off_gcd=1
actions+=/consecration,focus=2
actions+=/call_action_list,name=cast_selected_seal,if=((action.seal_of_righteousness.known&!buff.seal_of_righteousness.up)|((!action.seal_of_righteousness.known|buff.seal_of_righteousness.remains<=10)&(!action.seal_of_righteousness.known|(!action.consecration.known|cooldown.consecration.remains>=action.seal_of_righteousness.gcd))&(!action.seal_of_righteousness.known|(!action.holy_shock.known|cooldown.holy_shock.remains>=action.seal_of_righteousness.gcd))&(!action.seal_of_righteousness.known|(!action.holy_strike.known|cooldown.holy_strike.remains>=action.seal_of_righteousness.gcd))))
actions+=/holy_strike
actions+=/divine_favor,use_off_gcd=1,if=(!action.holy_shock.known|cooldown.holy_shock.ready)
actions+=/holy_shock
actions+=/hammer_of_wrath,focus=1,if=(action.hammer_of_wrath.cast=0|mainhand_remains>mainhand_speed-0.2)
actions+=/exorcism
actions.activate_assigned_aura=retribution_aura,if=!buff.retribution_aura.up
actions.cast_assigned_judgement=seal_of_the_crusader,if=!buff.seal_of_the_crusader.up
actions.cast_selected_seal=seal_of_righteousness,focus=2
