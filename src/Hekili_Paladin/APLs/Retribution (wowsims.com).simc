# Retribution (wowsims.com): the wowsims/forever default APL for Retribution (ui/specs/paladin/retribution/apls/twist_of_light.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/paladin_retribution.lua: edit that recipe, not this file.
# Omitted: precombat #2: prepullSkip (recipe)

actions.precombat=retribution_aura,if=!buff.retribution_aura.up
actions.precombat+=/seal_of_the_crusader,if=!buff.seal_of_the_crusader.up
actions=use_items,use_off_gcd=1
actions+=/judgement,use_off_gcd=1
actions+=/hammer_of_wrath,focus=1,if=(action.hammer_of_wrath.cast=0|(mainhand_speed-mainhand_remains)<0.2)
actions+=/holy_strike,if=time>0.5
actions+=/seal_of_command,focus=1,if=talent.twist_of_light.enabled&(!buff.echo_of_command.up&!buff.seal_of_command.up)
actions+=/seal_of_righteousness,focus=1,if=talent.twist_of_light.enabled&(!buff.echo_of_righteousness.up&!buff.seal_of_righteousness.up)
actions+=/call_action_list,name=consecration
actions+=/call_action_list,name=exorcism
actions+=/seal_of_command,focus=2,if=!talent.twist_of_light.enabled&!buff.seal_of_command.up
actions+=/seal_of_righteousness,focus=2,if=!action.seal_of_command.known&buff.seal_of_righteousness.remains<24
actions.exorcism=exorcism,if=(mainhand_remains>1.5&mana.pct>=10)
actions.consecration=consecration,focus=2,if=(mainhand_remains>1.5&mana.pct>=10)
