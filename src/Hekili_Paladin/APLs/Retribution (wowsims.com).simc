# Retribution (wowsims.com): the wowsims/forever default APL for Retribution (ui/specs/paladin/retribution/apls/default.apl.siml), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e5a9cd2a2dfc.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/paladin_retribution.lua: edit that recipe, not this file.
# Window: move1: steps judgement, seal_of_command; on_deviation stay; evaluator talent.seal_of_command.enabled (the class registers it).
# Window: move2: steps judgement, seal_of_righteousness; on_deviation stay; evaluator (!talent.twist_of_light.enabled|!talent.seal_of_command.enabled) (the class registers it).
# Movement: move_to_melee #1 reaches move_to_melee: judgement; default: judgement, use_items, hammer_of_wrath, holy_strike, seal_of_command, seal_of_righteousness, consecration, exorcism
# Movement: move_to_melee #2 reaches move_to_melee: judgement; default: judgement, use_items, hammer_of_wrath, holy_strike, seal_of_command, seal_of_righteousness, consecration, exorcism
# Omitted: precombat #2: move
# Omitted: prep_seal_of_command #1: never
# Omitted: prep_seal_of_righteousness #1: never
# Omitted: move_to_melee #3: never
# Omitted: precombat: empty group prep_seal_of_command
# Omitted: precombat: empty group prep_seal_of_righteousness

actions.precombat=call_action_list,name=activate_assigned_aura
actions.precombat+=/call_action_list,name=cast_assigned_judgement
actions=call_action_list,name=move_to_melee,if=(!action.holy_strike.known|!action.holy_strike.in_range)
actions+=/judgement,use_off_gcd=1,if=(mainhand_remains<=mainhand_speed-0.1&mainhand_remains>=0.1)&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/use_items,use_off_gcd=1,if=time>=0&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/hammer_of_wrath,focus=1,if=(action.hammer_of_wrath.cast=0|mainhand_remains>mainhand_speed-0.2)&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/holy_strike,if=((mainhand_remains<=mainhand_speed-0.1&mainhand_remains>=0.1)&(!action.judgement.known|!cooldown.judgement.ready)&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/seal_of_command,if=talent.twist_of_light.enabled&talent.seal_of_command.enabled&!buff.seal_of_command.up&(!action.seal_of_righteousness.known|!buff.seal_of_righteousness.up)&(!seal_up|(action.judgement.known&cooldown.judgement.remains>0))
actions+=/seal_of_command,focus=1,if=talent.twist_of_light.enabled&((!buff.seal_of_command.up|(buff.seal_of_command.up&buff.seal_of_command.remains<=mainhand_remains))&(!talent.twist_of_light.enabled|(!buff.seal_of_command.up&buff.echo_of_righteousness.stack>=1))&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/seal_of_righteousness,focus=1,if=talent.twist_of_light.enabled&((!talent.seal_of_command.enabled|talent.twist_of_light.enabled)&(!buff.seal_of_righteousness.up|(buff.seal_of_righteousness.up&buff.seal_of_righteousness.remains<=mainhand_remains))&(!talent.twist_of_light.enabled|!talent.seal_of_command.enabled|(!buff.seal_of_righteousness.up&buff.echo_of_command.stack=3))&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/call_action_list,name=consecration,if=(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/call_action_list,name=exorcism,if=(toggle.movement&(window.move1.up|window.move2.up)|(!action.holy_strike.known|action.holy_strike.in_range)|!window.move1.up&!window.move2.up)
actions+=/seal_of_command,focus=2,if=!talent.twist_of_light.enabled&!buff.seal_of_command.up
actions+=/seal_of_righteousness,focus=2,if=!action.seal_of_command.known&buff.seal_of_righteousness.remains<gcd.max*2
actions.activate_assigned_aura=retribution_aura,if=!buff.retribution_aura.up
actions.cast_assigned_judgement=seal_of_the_crusader,if=!buff.seal_of_the_crusader.up
actions.move_to_melee=judgement,use_off_gcd=1,if=window.move1.next.judgement&(toggle.movement&window.move1.up|action.judgement.in_range)
actions.move_to_melee+=/seal_of_command,focus=1,if=window.move1.next.seal_of_command&talent.twist_of_light.enabled
actions.move_to_melee+=/judgement,use_off_gcd=1,if=window.move2.next.judgement&(toggle.movement&window.move2.up|action.judgement.in_range)
actions.move_to_melee+=/seal_of_righteousness,focus=1,if=window.move2.next.seal_of_righteousness&talent.twist_of_light.enabled
actions.exorcism=exorcism,if=(mainhand_remains>1.5&mana.pct_lo>=10&(!action.judgement.known|!cooldown.judgement.ready)&(!action.holy_strike.known|!cooldown.holy_strike.ready))
actions.consecration=consecration,focus=2,if=(mainhand_remains>1.5&mana.pct_lo>=10&(!action.judgement.known|!cooldown.judgement.ready)&(!action.holy_strike.known|!cooldown.holy_strike.ready))
