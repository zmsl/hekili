# Retribution (wowsims.com): the wowsims/forever default APL for Retribution (ui/specs/paladin/retribution/apls/default.apl.siml), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/paladin_retribution.lua: edit that recipe, not this file.
# Setting divine_shield_health (player health threshold, percent), default 20.
# Setting lay_on_hands_health (player health threshold, percent), default 15.
# Setting healing_potion_health (player health threshold, percent), default 25.
# Setting healthstone_health (player health threshold, percent), default 30.
# Movement: move_to_melee #1 reaches move_to_melee: judgement; default: judgement, use_items, hammer_of_wrath, holy_strike, seal_of_command, seal_of_righteousness, consecration, exorcism
# Movement: move_to_melee #2 reaches move_to_melee: judgement; default: judgement, use_items, hammer_of_wrath, holy_strike, seal_of_command, seal_of_righteousness, consecration, exorcism
# Omitted: precombat #2: move
# Omitted: prep_seal_of_command #1: never
# Omitted: prep_seal_of_righteousness #1: never
# Omitted: move_to_melee #3: never
# Omitted: precombat: empty group prep_seal_of_command
# Omitted: precombat: empty group prep_seal_of_righteousness

actions.precombat=call_action_list,name=activate_assigned_aura
actions.precombat+=/call_action_list,name=cast_assigned_judgement
actions=divine_shield,if=health.known&health.pct<=settings.divine_shield_health
actions+=/lay_on_hands,if=health.known&health.pct<=settings.lay_on_hands_health&(!action.divine_shield.known|!buff.divine_shield.up)
actions+=/healthstone,use_off_gcd=1,if=health.known&health.pct<=settings.healthstone_health
actions+=/healing_potion,use_off_gcd=1,if=health.known&health.pct<=settings.healing_potion_health
actions+=/close_window,name=move1,if=window.move1.up&!window.move1.done&!(window.before_first_swing.up)
actions+=/close_window,name=move2,if=window.move2.up&!window.move2.done&!(window.before_first_swing.up)
actions+=/call_action_list,name=move_to_melee,if=(!action.holy_strike.known|!action.holy_strike.in_range)
actions+=/judgement,use_off_gcd=1,if=(mainhand_remains<=mainhand_speed-0.1&mainhand_remains>=0.1)&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/use_items,use_off_gcd=1,if=time>=0&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/hammer_of_wrath,focus=1,if=(action.hammer_of_wrath.cast=0|mainhand_remains>mainhand_speed-0.2)&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/holy_strike,if=((mainhand_remains<=mainhand_speed-0.1&mainhand_remains>=0.1)&(!action.judgement.known|!cooldown.judgement.ready)&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/seal_of_command,if=talent.twist_of_light.enabled&talent.seal_of_command.enabled&!buff.seal_of_command.up&(!action.seal_of_righteousness.known|!buff.seal_of_righteousness.up)&(!seal_up|(action.judgement.known&cooldown.judgement.remains>0))
actions+=/seal_of_command,focus=1,if=talent.twist_of_light.enabled&((!buff.seal_of_command.up|(buff.seal_of_command.up&buff.seal_of_command.remains<=mainhand_remains))&(!talent.twist_of_light.enabled|(!buff.seal_of_command.up&buff.echo_of_righteousness.stack>=1))&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/seal_of_righteousness,focus=1,if=talent.twist_of_light.enabled&((!talent.seal_of_command.enabled|talent.twist_of_light.enabled)&(!buff.seal_of_righteousness.up|(buff.seal_of_righteousness.up&buff.seal_of_righteousness.remains<=mainhand_remains))&(!talent.twist_of_light.enabled|!talent.seal_of_command.enabled|(!buff.seal_of_righteousness.up&buff.echo_of_command.stack=3))&(!action.judgement.known|cooldown.judgement.remains<=(cooldown.judgement.duration-0)))&(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/call_action_list,name=consecration,if=(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/call_action_list,name=exorcism,if=(toggle.movement&((window.move1.up&!window.move1.done)|(window.move2.up&!window.move2.done))|(!action.holy_strike.known|action.holy_strike.in_range)|(!window.move1.up|window.move1.done)&(!window.move2.up|window.move2.done))
actions+=/seal_of_command,focus=2,if=!talent.twist_of_light.enabled&!buff.seal_of_command.up
actions+=/seal_of_righteousness,focus=2,if=!action.seal_of_command.known&buff.seal_of_righteousness.remains<gcd.max*2
actions.activate_assigned_aura=retribution_aura,if=!buff.retribution_aura.up
actions.cast_assigned_judgement=seal_of_the_crusader,if=!buff.seal_of_the_crusader.up
actions.move_to_melee=sequence,name=move1,mode=continue,if=(talent.seal_of_command.enabled&!window.move1.done)&window.before_first_swing.up:judgement,use_off_gcd=1,if=(toggle.movement|action.judgement.in_range):seal_of_command,focus=1,if=talent.twist_of_light.enabled
actions.move_to_melee+=/sequence,name=move2,mode=continue,if=((!talent.twist_of_light.enabled|!talent.seal_of_command.enabled)&!window.move2.done)&window.before_first_swing.up:judgement,use_off_gcd=1,if=(toggle.movement|action.judgement.in_range):seal_of_righteousness,focus=1,if=talent.twist_of_light.enabled
actions.exorcism=exorcism,if=(mainhand_remains>1.5&mana.pct_lo>=10&(!action.judgement.known|!cooldown.judgement.ready)&(!action.holy_strike.known|!cooldown.holy_strike.ready))
actions.consecration=consecration,focus=2,if=(mainhand_remains>1.5&mana.pct_lo>=10&(!action.judgement.known|!cooldown.judgement.ready)&(!action.holy_strike.known|!cooldown.holy_strike.ready))
