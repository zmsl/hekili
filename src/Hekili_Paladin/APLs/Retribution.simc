# Forever Retribution Paladin (provisional: no in-game check yet; the seals, Echoes and Judgement's effect on the seal
# are modelled from our casts): Judgement on cooldown, Hammer of Wrath in the execute window at tier 1, Holy Strike,
# the Twist of Light seal twist (Seal of Command and Seal of Righteousness, each when it and its Echo are down) at tier
# 1, Consecration and Exorcism in the swing gap at tier 2 (their mana floors are settings, off by default); with the
# Holy Shock talent, its own list (after wowsims/forever's Retribution APLs, reference only).

actions.precombat=retribution_aura,if=!buff.retribution_aura.up
actions.precombat+=/seal_of_command,if=!seal_up
actions.precombat+=/seal_of_righteousness,if=!seal_up
actions=run_action_list,name=holy_shock,if=talent.holy_shock.enabled
actions+=/judgement,use_off_gcd=1
actions+=/hammer_of_wrath,focus=1
actions+=/holy_strike
actions+=/seal_of_command,focus=1,if=talent.twist_of_light.enabled&!buff.echo_of_command.up&!buff.seal_of_command.up
actions+=/seal_of_righteousness,focus=1,if=talent.twist_of_light.enabled&!buff.echo_of_righteousness.up&!buff.seal_of_righteousness.up
actions+=/seal_of_command,if=!talent.twist_of_light.enabled&!seal_up
actions+=/seal_of_righteousness,if=!talent.twist_of_light.enabled&!seal_up
actions+=/consecration,focus=2,if=mainhand_remains>1.5&mana.pct>=settings.consecration_mana
actions+=/exorcism,focus=2,if=mainhand_remains>1.5&mana.pct>=settings.exorcism_mana
actions.holy_shock=judgement,use_off_gcd=1
actions.holy_shock+=/consecration
actions.holy_shock+=/hammer_of_wrath,focus=1
actions.holy_shock+=/seal_of_righteousness,if=!buff.seal_of_righteousness.up
actions.holy_shock+=/holy_strike
actions.holy_shock+=/divine_favor,use_off_gcd=1,if=cooldown.holy_shock.remains=0&debuff.consecrated_ground.up
actions.holy_shock+=/holy_shock,if=debuff.consecrated_ground.up
actions.holy_shock+=/exorcism
