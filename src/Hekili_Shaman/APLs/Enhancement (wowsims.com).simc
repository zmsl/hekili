actions.precombat=grace_of_air_totem,focus=2,prepull_at=8
actions.precombat+=/flametongue_totem,prepull_at=7
actions.precombat+=/strength_of_earth_totem,focus=2,prepull_at=6
actions.precombat+=/mana_spring_totem,prepull_at=5
actions=major_mana_potion,use_off_gcd=1,if=mana.pct<80
actions+=/demonic_rune,use_off_gcd=1,if=mana.pct<70
actions+=/blood_fury,use_off_gcd=1
actions+=/grace_of_air_totem,focus=2,if=totem.air.remains<=0
actions+=/strength_of_earth_totem,focus=2,if=totem.earth.remains<=0
actions+=/fire_nova,focus=1,if=buff.clearcasting.up
actions+=/lightning_shield,focus=2,if=!buff.lightning_shield.up
actions+=/searing_totem,focus=2,if=totem.fire.remains<=0
actions+=/stormstrike
actions+=/lightning_bolt,focus=1,if=buff.maelstrom_weapon.stack>=5
actions+=/flame_shock,focus=2,if=!debuff.flame_shock.up
actions+=/earth_shock
actions+=/fire_nova,focus=1,if=mana.pct>10
actions+=/lightning_bolt,if=!action.stormstrike.known
