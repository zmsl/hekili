# Enhancement (wowsims.com): the wowsims/forever default APL for Enhancement (ui/specs/shaman/enhancement/builds/testing.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e2842f0a784d.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/shaman_enhancement.lua: edit that recipe, not this file.
# Deviation: single_target_rotation #1: multidot keeps the DoT on up to 1 targets in wowsims; this line is for the current target only.
# Deviation: aoe_rotation #3: multidot keeps the DoT on up to 3 targets in wowsims; this line is for the current target only.
# Omitted: default #3: dropped the unresolved aura nil (its branch only)
# Omitted: default #8: autocastOtherCooldowns: unmapped item 9449
# Omitted: default #8: autocastOtherCooldowns: unmapped item 249469
# Omitted: default #9: itemSwap
# Omitted: aoe_rotation #1: autoTimeToNext

actions.precombat=flametongue_weapon,if=!buff.main_hand_enchant.up
actions.precombat+=/rockbiter_weapon,if=!buff.main_hand_enchant.up&!action.flametongue_weapon.known
actions.precombat+=/water_shield,if=!buff.water_shield.up&!buff.water_shield.up
actions.precombat+=/windfury_totem,if=!totem.air.up
actions.precombat+=/mana_spring_totem,if=!totem.water.up
actions.precombat+=/strength_of_earth_totem,if=!totem.earth.up
actions.precombat+=/magma_totem,if=!totem.fire.up
actions=flametongue_weapon,if=!buff.main_hand_enchant.up
actions+=/rockbiter_weapon,if=!buff.main_hand_enchant.up&!action.flametongue_weapon.known
actions+=/major_mana_potion,use_off_gcd=1,if=mana.pct_lo<80
actions+=/demonic_rune,use_off_gcd=1,if=mana.pct_lo<70
actions+=/water_shield,focus=2,if=!buff.water_shield.up
actions+=/windfury_totem,if=totem.air.remains<=2
actions+=/strength_of_earth_totem,if=totem.earth.remains<=2
actions+=/mana_spring_totem,if=totem.water.remains<=2
actions+=/magma_totem,if=totem.fire.remains<=2
actions+=/use_items,use_off_gcd=1
actions+=/rage_of_the_farseer,use_off_gcd=1
actions+=/call_action_list,name=single_target_rotation,if=active_enemies=1
actions+=/call_action_list,name=aoe_rotation,if=active_enemies>1
actions+=/lightning_bolt,if=!action.stormstrike.known
actions.single_target_rotation=flame_shock,focus=2,if=debuff.flame_shock.remains<=0
actions.single_target_rotation+=/stormstrike
actions.single_target_rotation+=/lightning_bolt,focus=1,if=buff.maelstrom_weapon.stack=5
actions.single_target_rotation+=/earth_shock
actions.single_target_rotation+=/fire_nova
actions.aoe_rotation=fire_nova
actions.aoe_rotation+=/flame_shock,focus=2,if=debuff.flame_shock.remains<=0
actions.aoe_rotation+=/stormstrike
actions.aoe_rotation+=/lightning_bolt,focus=1,if=buff.maelstrom_weapon.stack=5
actions.aoe_rotation+=/earth_shock
