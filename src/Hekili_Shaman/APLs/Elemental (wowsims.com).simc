# Elemental (wowsims.com): the wowsims/forever default APL for Elemental (ui/specs/shaman/elemental/builds/testing.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e5a9cd2a2dfc.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/shaman_elemental.lua: edit that recipe, not this file.
# Deviation: default #13: multidot keeps the DoT on up to 3 targets in wowsims; this line is for the current target only.

actions.precombat=water_shield,if=!buff.water_shield.up
actions.precombat+=/strength_of_earth_totem,if=!totem.earth.up
actions.precombat+=/windfury_totem,if=!totem.air.up
actions.precombat+=/mana_spring_totem,if=!totem.water.up
actions.precombat+=/searing_totem,if=!totem.fire.up&active_enemies=1
actions.precombat+=/magma_totem,if=!totem.fire.up&active_enemies>1
actions=major_mana_potion,use_off_gcd=1,if=mana.pct_lo<80
actions+=/demonic_rune,use_off_gcd=1,if=mana.pct_lo<70
actions+=/mana_tide_totem,if=mana.pct_lo<50
actions+=/water_shield,if=!buff.water_shield.up
actions+=/use_items,use_off_gcd=1
actions+=/searing_totem,if=(active_enemies=1&totem.fire.remains<=0)
actions+=/magma_totem,if=(active_enemies>1&totem.fire.remains<=0)
actions+=/elemental_mastery,use_off_gcd=1,if=(!action.flame_shock.known|debuff.flame_shock.up)
actions+=/blood_fury,use_off_gcd=1,if=(!action.flame_shock.known|debuff.flame_shock.up)
actions+=/berserking,use_off_gcd=1,if=(!action.flame_shock.known|debuff.flame_shock.up)
actions+=/chain_lightning,if=(active_enemies>1|(mana.pct_lo>=40&(!action.elemental_mastery.known|!buff.elemental_mastery.up)))
actions+=/fire_nova,if=active_enemies>1
actions+=/flame_shock,focus=2,if=debuff.flame_shock.remains<=0
actions+=/earth_shock,focus=1,if=(active_enemies=1&buff.revelation.up)
actions+=/lightning_bolt,if=mana.pct_lo<20
actions+=/lightning_bolt
