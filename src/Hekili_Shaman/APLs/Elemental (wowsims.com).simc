# Elemental (wowsims.com): the wowsims/forever default APL for Elemental (ui/specs/shaman/elemental/builds/testing.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/shaman_elemental.lua: edit that recipe, not this file.
# Deviation: default #10: multidot keeps the DoT on up to 3 targets in wowsims; this line is for the current target only.
# Omitted: default #3: autocastOtherCooldowns: unmapped item 272438

actions.precombat=water_shield,prepull_at=5.5
actions.precombat+=/strength_of_earth_totem,prepull_at=4
actions.precombat+=/windfury_totem,prepull_at=3
actions.precombat+=/mana_spring_totem,prepull_at=2
actions.precombat+=/searing_totem,prepull_at=1,if=active_enemies=1
actions.precombat+=/magma_totem,prepull_at=1,if=active_enemies>1
actions=major_mana_potion,use_off_gcd=1,if=mana.pct<80
actions+=/demonic_rune,use_off_gcd=1,if=mana.pct<70
actions+=/berserking,use_off_gcd=1
actions+=/mana_tide_totem,if=mana.pct<50
actions+=/searing_totem,if=(active_enemies=1&totem.fire.remains<=0)
actions+=/magma_totem,if=(active_enemies>1&totem.fire.remains<=0)
actions+=/fire_nova,if=active_enemies>1
actions+=/chain_lightning,if=active_enemies>1
actions+=/lava_burst,if=(!action.flame_shock.known|debuff.flame_shock.up)
actions+=/flame_shock,focus=2,if=debuff.flame_shock.remains<=0
actions+=/earth_shock,focus=1,if=buff.revelation.up
actions+=/elemental_mastery,use_off_gcd=1
actions+=/lightning_bolt,if=mana.pct<20
actions+=/lightning_bolt
