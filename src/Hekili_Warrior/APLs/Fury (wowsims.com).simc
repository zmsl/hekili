actions.precombat=berserker_rage,if=talent.improved_berserker_rage.enabled
actions.precombat+=/bloodrage,use_off_gcd=1
actions.precombat+=/battle_shout,if=!buff.battle_shout.up
actions.precombat+=/reckless_swings
actions.precombat+=/call_action_list,name=pre_pull_move
actions=call_action_list,name=sunder_armor,if=active_enemies=1
actions+=/call_action_list,name=cd_racials
actions+=/death_wish,if=(fight_remains<=buff.death_wish.duration|fight_remains>(cooldown.death_wish.duration+(buff.death_wish.duration/2)))
actions+=/recklessness,if=(settings.wowsims_recklessness&(fight_remains<=buff.recklessness.duration|fight_remains>(cooldown.recklessness.duration+(buff.recklessness.duration/2))))
actions+=/sweeping_strikes,use_off_gcd=1,if=active_enemies>1
actions+=/whirlwind,if=active_enemies>1
actions+=/call_action_list,name=overpower_weaving
actions+=/spearing_strike,if=(!action.battle_stance.known|buff.battle_stance.up)
actions+=/execute,if=execute_phase
actions+=/whirlwind
actions+=/cleave,use_off_gcd=1,focus=2,if=(active_enemies>1&rage.lo>=25)
actions+=/victory_rush,focus=1
actions+=/bloodthirst
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=((active_enemies=1&!execute_phase&rage.lo>=40)|((!(action.bloodthirst.known|action.whirlwind.known)|((!action.bloodthirst.known|cooldown.bloodthirst.remains>=action.bloodthirst.gcd)&(!action.whirlwind.known|cooldown.whirlwind.remains>=action.whirlwind.gcd)))&rage.lo>60))
actions+=/battle_stance,use_off_gcd=1,focus=1,if=(active_enemies=1&(settings.wowsims_rend_weave&!execute_phase&(!action.rend.known|!debuff.rend.up)&rage.lo>=10)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))&(!action.overpower.known|(stance_rage_kept>=action.overpower.cost&cooldown.overpower.remains<buff.overpower_ready.remains))
actions+=/rend,focus=2,if=((action.battle_stance.known&prev.1.battle_stance)|(!action.battle_stance.known&(active_enemies=1&(settings.wowsims_rend_weave&!execute_phase&(!action.rend.known|!debuff.rend.up)&rage.lo>=10)&(!action.battle_stance.known|cooldown.battle_stance.remains<=0))))&(active_enemies=1&(settings.wowsims_rend_weave&!execute_phase&(!action.rend.known|!debuff.rend.up)&rage.lo>=10))
actions+=/rend,focus=2,if=(settings.wowsims_rend_weave&!execute_phase&!debuff.rend.up&rage.lo>=10)
actions+=/berserker_stance,use_off_gcd=1,if=((!action.battle_stance.known|buff.battle_stance.up)&!((buff.overpower_ready.up&rage.lo>=5&rage.lo<=73&(!action.overpower.known|cooldown.overpower.ready))|(settings.wowsims_rend_weave&!execute_phase&(!action.rend.known|!debuff.rend.up)&rage.lo>=10)))
actions+=/reckless_swings
actions+=/bloodrage,use_off_gcd=1,if=((fight_remains>cooldown.bloodrage.duration&rage.lo<90)|fight_remains<2|(execute_phase&(!action.execute.known|(rage.lo+10)>=action.execute.cost)&(!action.execute.known|!action.execute.ready)&min(mainhand_remains,offhand_remains)>0.5&(!action.berserker_stance.known|buff.berserker_stance.up)))
actions+=/berserker_rage,if=((!(action.bloodthirst.known|action.whirlwind.known)|((!action.bloodthirst.known|cooldown.bloodthirst.remains>=action.bloodthirst.gcd)&(!action.whirlwind.known|cooldown.whirlwind.remains>=action.whirlwind.gcd)))&talent.improved_berserker_rage.enabled)
actions+=/battle_shout,if=((!(action.bloodthirst.known|action.whirlwind.known)|((!action.bloodthirst.known|cooldown.bloodthirst.remains>=action.bloodthirst.gcd)&(!action.whirlwind.known|cooldown.whirlwind.remains>=action.whirlwind.gcd)))&buff.battle_shout.remains<=10)
actions+=/sunder_armor,if=!action.bloodthirst.known&debuff.sunder_armor.stack<5
actions.pre_pull_move=charge,use_off_gcd=1,if=(!action.battle_stance.known|buff.battle_stance.up)
actions.pre_pull_move+=/intercept,use_off_gcd=1,if=(!action.berserker_stance.known|buff.berserker_stance.up)
actions.cd_racials=blood_fury,use_off_gcd=1,if=(fight_remains<=buff.blood_fury.duration|fight_remains>(cooldown.blood_fury.duration+(buff.blood_fury.duration/2)))
actions.cd_racials+=/berserking,use_off_gcd=1,if=(fight_remains<=buff.berserking.duration|fight_remains>(cooldown.berserking.duration+(buff.berserking.duration/2)))
actions.cd_racials+=/eureka,use_off_gcd=1,if=(fight_remains<=buff.eureka.duration|fight_remains>(cooldown.eureka.duration+(buff.eureka.duration/2)))
actions.cd_racials+=/elunes_light,use_off_gcd=1,if=(!settings.wowsims_recklessness&(fight_remains<=buff.elunes_light.duration|fight_remains>(cooldown.elunes_light.duration+(buff.elunes_light.duration/2))))
actions.cd_racials+=/elunes_light,use_off_gcd=1,if=(settings.wowsims_recklessness&(!action.recklessness.known|!buff.recklessness.up)&fight_remains>15&(fight_remains>195|fight_remains<=30))
actions.sunder_armor=sunder_armor,if=debuff.sunder_armor.stack<5
actions.overpower_weaving=battle_stance,use_off_gcd=1,focus=1,if=((buff.overpower_ready.up&rage.lo>=5&rage.lo<=73&(!action.overpower.known|cooldown.overpower.ready))&buff.overpower_ready.remains>gcd.remains&(!action.battle_stance.known|cooldown.battle_stance.remains<=0)&(!action.overpower.known|cooldown.overpower.remains<=0))&(!action.overpower.known|(stance_rage_kept>=action.overpower.cost&cooldown.overpower.remains<buff.overpower_ready.remains))
actions.overpower_weaving+=/overpower,focus=1,if=((action.battle_stance.known&prev.1.battle_stance)|(!action.battle_stance.known&((buff.overpower_ready.up&rage.lo>=5&rage.lo<=73&(!action.overpower.known|cooldown.overpower.ready))&buff.overpower_ready.remains>gcd.remains&(!action.battle_stance.known|cooldown.battle_stance.remains<=0)&(!action.overpower.known|cooldown.overpower.remains<=0))))&((buff.overpower_ready.up&rage.lo>=5&rage.lo<=73&(!action.overpower.known|cooldown.overpower.ready))&buff.overpower_ready.remains>gcd.remains&(!action.overpower.known|cooldown.overpower.remains<=0))
actions.overpower_weaving+=/overpower,focus=1,if=(buff.overpower_ready.up&rage.lo>=5&rage.lo<=73&cooldown.overpower.ready)
