actions.precombat=berserker_rage,prepull_at=4.5
actions.precombat+=/call_action_list,name=pre_pull_stance
actions.precombat+=/bloodrage,use_off_gcd=1,prepull_at=3
actions.precombat+=/battle_shout,prepull_at=3
actions.precombat+=/call_action_list,name=pre_pull_move
actions=call_action_list,name=sunder_armor,if=active_enemies=1
actions+=/call_action_list,name=cd_racials
actions+=/death_wish
actions+=/recklessness,if=settings.wowsims_recklessness
actions+=/sweeping_strikes,use_off_gcd=1,if=active_enemies>1
actions+=/battle_stance,use_off_gcd=1,if=(!settings.wowsims_stance_dance&!buff.battle_stance.up)
actions+=/mortal_strike,if=settings.wowsims_stance_dance
actions+=/rend,focus=2,if=(!execute_phase&(!action.battle_stance.known|buff.battle_stance.up)&debuff.rend.remains<=1.5)
actions+=/overpower,focus=1,if=(!action.battle_stance.known|buff.battle_stance.up)
actions+=/mortal_strike,if=!settings.wowsims_stance_dance
actions+=/spearing_strike,if=(!execute_phase&(!action.battle_stance.known|buff.battle_stance.up))
actions+=/berserker_stance,use_off_gcd=1,if=(settings.wowsims_stance_dance&(!action.battle_stance.known|buff.battle_stance.up)&!buff.overpower_ready.up&(execute_phase|(action.rend.known&debuff.rend.remains>1.5)))
actions+=/slam,focus=2,if=(!execute_phase&action.slam.cast<1.5)
actions+=/slam,focus=2,if=(!execute_phase&action.slam.cast>=1.5&(mainhand_speed-mainhand_remains)<=(0+0.3))
actions+=/whirlwind,if=settings.wowsims_stance_dance
actions+=/execute,if=execute_phase
actions+=/battle_stance,use_off_gcd=1,if=(settings.wowsims_stance_dance&!execute_phase&(!action.berserker_stance.known|buff.berserker_stance.up)&(buff.overpower_ready.up|(action.rend.known&debuff.rend.remains<=1.5)))
actions+=/cleave,use_off_gcd=1,if=(active_enemies>1&rage.current>=40)
actions+=/heroic_strike,use_off_gcd=1,if=(!execute_phase&rage.current>=90)
actions+=/bloodrage,use_off_gcd=1,if=rage.current<90
actions+=/battle_shout,if=(((!action.mortal_strike.known|cooldown.mortal_strike.remains>=1.5)&(!settings.wowsims_stance_dance|(action.whirlwind.known&cooldown.whirlwind.remains>=1.5)))&buff.battle_shout.remains<=10)
actions+=/heroic_strike,use_off_gcd=1,if=!action.mortal_strike.known&rage.current>=30
actions+=/thunder_clap,if=!action.mortal_strike.known&!debuff.thunder_clap.up&rage.current>=40
actions+=/sunder_armor,if=!action.mortal_strike.known&debuff.sunder_armor.stack<5
actions.pre_pull_stance=battle_stance,use_off_gcd=1,if=!settings.wowsims_stance_dance
actions.pre_pull_move=charge,use_off_gcd=1,if=(!action.battle_stance.known|buff.battle_stance.up)
actions.pre_pull_move+=/intercept,use_off_gcd=1,if=(!action.berserker_stance.known|buff.berserker_stance.up)
actions.cd_racials=blood_fury,use_off_gcd=1
actions.cd_racials+=/berserking,use_off_gcd=1
actions.cd_racials+=/eureka,use_off_gcd=1
actions.cd_racials+=/elunes_light,use_off_gcd=1
actions.sunder_armor=sunder_armor,if=debuff.sunder_armor.stack<5
