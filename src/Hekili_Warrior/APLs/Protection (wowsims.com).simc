# Protection (wowsims.com): the wowsims/forever default APL for Protection (ui/specs/warrior/protection/apls/default.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.
# Cooldowns toggle hides: Death Wish, Sweeping Strikes and the racials (Blood Fury, Berserking, Eureka, Elune's Light).
# Defensives toggle hides: Shield Wall, Last Stand, Healthstone and the racials Stoneform and Shatter Curse. No line here sits under the Potions toggle.
# Last Stand, Shield Wall, Stoneform, Shatter Curse and Healthstone wait for low health, and the game hides your health from addons in combat, so they never show there: use them by hand.
# Demoralizing Shout is off unless you turn on Maintain Demoralizing Shout. To keep it (when on) and Thunder Clap for bosses, tick Boss Encounter Only on those abilities, or put them under the Custom 1 toggle.
# Rend is used on every target, boss or not.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warrior_protection.lua: edit that recipe, not this file.
# Setting maintain_demoralizing_shout (maintenance debuff: demoralizing_shout), default off in game, on in the harness.
# Omitted: precombat #3: other OtherActionOffensivePotion
# Omitted: default #4: hidden
# Omitted: default #7: hidden
# Omitted: default #11: other OtherActionDefensivePotion
# Omitted: default #12: other OtherActionOffensivePotion
# Omitted: default #13: other OtherActionResourcePotion
# Omitted: default #19: hidden
# Omitted: default #26: dropped the unresolved aura 27648 (its branch only)
# Omitted: default #33: never
# Omitted: default #34: never
# Omitted: default #35: hidden
# Omitted: engineering #1: item 10646
# Omitted: engineering #2: item 11566
# Omitted: engineering #3: item 18588
# Omitted: cd_offensive_trinkets #1: item 21670
# Omitted: cd_offensive_trinkets #2: item 22954
# Omitted: cd_offensive_trinkets #3: item 23041
# Omitted: cd_offensive_trinkets #4: item 272440
# Omitted: cd_shield_wall_dual_wield #1: strictSequence of itemSwap
# Omitted: cd_shield_wall_dual_wield #2: itemSwap
# Omitted: default: empty group engineering
# Omitted: default: empty group cd_offensive_trinkets
# Omitted: default: empty group cd_shield_wall_dual_wield

actions.precombat=battle_shout,if=!buff.battle_shout.up
actions.precombat+=/bloodrage,use_off_gcd=1
actions=last_stand,use_off_gcd=1,if=(!(buff.last_stand.up|(action.shield_wall.known&buff.shield_wall.up))&health.pct<=40)
actions+=/shield_wall,if=(health.pct<=35&!((action.last_stand.known&buff.last_stand.up)|buff.shield_wall.up))
actions+=/stoneform,if=((!(action.last_stand.known|action.shield_wall.known)|!((action.last_stand.known&buff.last_stand.up)|(action.shield_wall.known&buff.shield_wall.up)))&health.pct<=50)
actions+=/shatter_curse,if=((!(action.last_stand.known|action.shield_wall.known)|!((action.last_stand.known&buff.last_stand.up)|(action.shield_wall.known&buff.shield_wall.up)))&health.pct<=50)
actions+=/healthstone,use_off_gcd=1,if=health.pct<=30
actions+=/death_wish
actions+=/call_action_list,name=cd_racials
actions+=/shield_block,use_off_gcd=1,if=(rage.current>=40|(!buff.revenge_usable.up&(!action.revenge.known|cooldown.revenge.remains<=1.5)))
actions+=/sweeping_strikes,use_off_gcd=1,if=active_enemies>1
actions+=/thunder_clap,if=active_enemies>2
actions+=/shield_slam
actions+=/victory_rush
actions+=/bloodthirst
actions+=/mortal_strike
actions+=/revenge,focus=1
actions+=/thunder_clap,if=active_enemies>1
actions+=/demoralizing_shout,if=settings.maintain_demoralizing_shout&debuff.demoralizing_shout.remains<=6
actions+=/thunder_clap,if=debuff.thunder_clap.remains<=6
actions+=/battle_shout,if=buff.battle_shout.remains<=10
actions+=/rend,if=(!debuff.rend.up&(!(offhand_speed=0)|(offhand_speed=0&(!action.shield_slam.known|cooldown.shield_slam.remains>=1.5))))
actions+=/sunder_armor,if=(debuff.sunder_armor.stack<5|((!action.shield_slam.known|cooldown.shield_slam.remains>=1.5)&debuff.sunder_armor.remains<=10))
actions+=/cleave,use_off_gcd=1,focus=1,if=(active_enemies>1&rage.current>=40)
actions+=/heroic_strike,use_off_gcd=1,focus=1,if=(active_enemies=1&rage.current>=40)
actions+=/bloodrage,use_off_gcd=1,if=rage.current<90
actions.cd_racials=blood_fury,use_off_gcd=1
actions.cd_racials+=/berserking,use_off_gcd=1
actions.cd_racials+=/eureka,use_off_gcd=1
actions.cd_racials+=/elunes_light,use_off_gcd=1
