# Protection (wowsims.com): the wowsims/forever default APL for Protection (ui/specs/warrior/protection/apls/default.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.
# Cooldowns toggle hides: Retaliation, Death Wish, Sweeping Strikes and the racials (Blood Fury, Berserking, Eureka, Elune's Light).
# No line here sits under the Potions or Defensives toggles.
# Last Stand, Shield Wall, Stoneform, Shatter Curse and Healthstone are not in this priority: they wait for low health, and the game hides your health from addons in combat. Use them by hand.
# Demoralizing Shout is off unless you turn on Maintain Demoralizing Shout. To keep it (when on) and Thunder Clap for bosses, tick Boss Encounter Only on those abilities, or put them under the Custom 1 toggle.
# Rend is used on every target, boss or not.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warrior_protection.lua: edit that recipe, not this file.
# Setting maintain_demoralizing_shout (maintenance debuff: demoralizing_shout), default off in game, on in the harness.
# Omitted: precombat #6: other OtherActionOffensivePotion
# Omitted: default #3: currentHealthPercent: the player's health, hidden in combat
# Omitted: default #4: hidden
# Omitted: default #6: currentHealthPercent: the player's health, hidden in combat
# Omitted: default #7: hidden
# Omitted: default #8: currentHealthPercent: the player's health, hidden in combat
# Omitted: default #9: currentHealthPercent: the player's health, hidden in combat
# Omitted: default #10: currentHealthPercent: the player's health, hidden in combat
# Omitted: default #11: other OtherActionDefensivePotion
# Omitted: default #12: other OtherActionOffensivePotion
# Omitted: default #14: other OtherActionResourcePotion
# Omitted: default #20: hidden
# Omitted: default #34: never
# Omitted: default #35: never
# Omitted: default #36: hidden
# Omitted: engineering #1: item 10646
# Omitted: engineering #2: item 260817
# Omitted: engineering #3: item 276145
# Omitted: engineering #4: item 16005
# Omitted: engineering #5: item 260816
# Omitted: engineering #6: item 11566
# Omitted: engineering #7: item 10830
# Omitted: engineering #8: item 15993
# Omitted: engineering #9: item 284868
# Omitted: engineering #10: item 260814
# Omitted: engineering #11: item 18588
# Omitted: cd_offensive_trinkets #1: item 21670
# Omitted: cd_offensive_trinkets #2: item 22954
# Omitted: cd_offensive_trinkets #3: item 23041
# Omitted: cd_offensive_trinkets #4: item 272440
# Omitted: cd_offensive_trinkets #5: item 272437
# Omitted: cd_offensive_trinkets #6: item 13965
# Omitted: cd_shield_wall_dual_wield #1: currentHealthPercent: the player's health, hidden in combat
# Omitted: cd_shield_wall_dual_wield #2: itemSwap
# Omitted: default: empty group engineering
# Omitted: default: empty group cd_offensive_trinkets
# Omitted: default: empty group cd_shield_wall_dual_wield

actions.precombat=bloodrage,use_off_gcd=1
actions.precombat+=/battle_shout,if=!buff.battle_shout.up
actions.precombat+=/battle_stance,use_off_gcd=1,if=!buff.battle_stance.up&(!action.defensive_stance.known|!buff.defensive_stance.up)
actions.precombat+=/retaliation
actions.precombat+=/defensive_stance,use_off_gcd=1,if=!buff.defensive_stance.up
actions=reckless_swings
actions+=/death_wish
actions+=/call_action_list,name=cd_racials
actions+=/shield_block,use_off_gcd=1,if=(rage.lo>=40|(!buff.revenge_usable.up&(!action.revenge.known|cooldown.revenge.remains<=1.5)))
actions+=/sweeping_strikes,use_off_gcd=1,if=active_enemies>1
actions+=/thunder_clap,if=active_enemies>2
actions+=/revenge,focus=1
actions+=/shield_slam
actions+=/victory_rush,focus=1
actions+=/bloodthirst
actions+=/mortal_strike
actions+=/thunder_clap,if=active_enemies>1
actions+=/demoralizing_shout,if=settings.maintain_demoralizing_shout&debuff.demoralizing_shout.remains<=6
actions+=/thunder_clap,if=(!debuff.thunderfury.up&debuff.thunder_clap.remains<=6)
actions+=/battle_shout,if=buff.battle_shout.remains<=10
actions+=/rend,if=(!debuff.rend.up&(!(offhand_speed=0)|(offhand_speed=0&(!action.shield_slam.known|cooldown.shield_slam.remains>=1.5))))
actions+=/sunder_armor,if=(debuff.sunder_armor.stack<5|((!action.shield_slam.known|cooldown.shield_slam.remains>=1.5)&debuff.sunder_armor.remains<=10))
actions+=/heroic_strike,use_off_gcd=1,focus=2,if=(active_enemies=1&rage.lo>=20)
actions+=/cleave,use_off_gcd=1,focus=2,if=(active_enemies>1&rage.lo>=40)
actions+=/bloodrage,use_off_gcd=1,if=rage.lo<90
actions.cd_racials=blood_fury,use_off_gcd=1
actions.cd_racials+=/berserking,use_off_gcd=1
actions.cd_racials+=/eureka,use_off_gcd=1
actions.cd_racials+=/elunes_light,use_off_gcd=1
