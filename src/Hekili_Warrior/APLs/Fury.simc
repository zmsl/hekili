# Forever Fury Warrior: the user's priority (2026-10-18), from Berserker Stance.

# Focus lines first. Overpower and Revenge only in the stance that allows them, never a swap for them. Heroic Strike
# and Cleave (on the next swing) need their rage threshold and must leave the cost of Bloodthirst and Whirlwind when
# either comes off cooldown before the next main-hand swing (the no-clip rule; an unknown one reserves nothing).
# Rend and Thunder Clap are silent in Berserker Stance (their `nobuff`); Sunder Armor and Demoralizing Shout work in
# every stance. Execute, Bloodrage, Battle Shout and Death Wish are left out on purpose
# (docs/research/2026-10-18-fury-vs-wowsims.md). Precombat keeps today's Charge opener: the engine needs a precombat
# list (Engine/Sim/Core.lua compares its wait before the default list).

actions.precombat=charge,use_off_gcd=1
actions=victory_rush,focus=1
actions+=/overpower,focus=1,if=buff.battle_stance.up
actions+=/revenge,focus=1,if=buff.defensive_stance.up
actions+=/heroic_strike,use_off_gcd=1,focus=1,if=rage.current>=settings.hs_threshold&active_enemies=1&(!action.bloodthirst.known|cooldown.bloodthirst.remains>=mainhand_remains|rage.current-action.heroic_strike.cost>=action.bloodthirst.cost)&(!action.whirlwind.known|cooldown.whirlwind.remains>=mainhand_remains|rage.current-action.heroic_strike.cost>=action.whirlwind.cost)
actions+=/cleave,use_off_gcd=1,focus=1,if=rage.current>=settings.cleave_threshold&active_enemies>1&(!action.bloodthirst.known|cooldown.bloodthirst.remains>=mainhand_remains|rage.current-action.cleave.cost>=action.bloodthirst.cost)&(!action.whirlwind.known|cooldown.whirlwind.remains>=mainhand_remains|rage.current-action.cleave.cost>=action.whirlwind.cost)
actions+=/rend,if=!buff.berserker_stance.up&!debuff.rend.up
actions+=/sunder_armor,if=settings.debuff_sunder_enabled&debuff.sunder_armor.stack<settings.debuff_sunder_max_stack&!debuff.expose_armor.up&target.level>=settings.debuff_sunder_min_level
actions+=/thunder_clap,if=settings.maintain_thunder_clap&!buff.berserker_stance.up&!debuff.thunder_clap.up
actions+=/demoralizing_shout,if=settings.debuff_demoshout_enabled&!debuff.demoralizing_shout.up
actions+=/bloodthirst
actions+=/whirlwind
