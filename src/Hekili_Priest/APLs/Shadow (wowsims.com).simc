actions.precombat=shadowguard,if=!buff.shadowguard.up&action.shadowguard.known
actions.precombat+=/mind_blast
actions=shadowform,if=!buff.shadowform.up
actions+=/dark_sacrifice,if=mana.lo<=2000
actions+=/elunes_light,use_off_gcd=1,if=(action.elunes_light.known&(gcd.remains<=0&(!action.shadow_word_pain.known|debuff.shadow_word_pain.remains>=10)&(!action.devouring_plague.known|((action.devouring_plague.known&debuff.devouring_plague.remains>=10)|(action.devouring_plague.known&cooldown.devouring_plague.remains>=8)))))
actions+=/eureka,use_off_gcd=1,if=(action.eureka.known&(gcd.remains<=0&(!action.shadow_word_pain.known|debuff.shadow_word_pain.remains>=8)&(!action.devouring_plague.known|((action.devouring_plague.known&debuff.devouring_plague.remains>=8)|(action.devouring_plague.known&cooldown.devouring_plague.remains>=8)))))
actions+=/berserking,use_off_gcd=1
actions+=/use_items,use_off_gcd=1
actions+=/demonic_rune,use_off_gcd=1
actions+=/major_mana_potion,use_off_gcd=1
actions+=/shadow_word_pain,focus=2,if=!debuff.shadow_word_pain.up
actions+=/devouring_plague,focus=2,if=!debuff.devouring_plague.up
actions+=/mind_blast
actions+=/shadow_word_death
actions+=/inner_focus,use_off_gcd=1,focus=1
actions+=/starshards,if=settings.prefer_starshards&(!action.mind_blast.known|cooldown.mind_blast.remains>=4)
actions+=/mind_flay,if=((action.inner_focus.known&prev.1.inner_focus)|(!action.inner_focus.known))
actions+=/mind_flay
actions+=/smite,if=!action.mind_flay.known
