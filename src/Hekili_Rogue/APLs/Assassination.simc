# Forever Assassination Rogue (provisional: no in-game check yet; Slice and Dice, Venom and the openers are modelled
# from our casts): Slice and Dice kept up at tier 1, Venom at 3 combo points, Cold Blood into a 5-point Eviscerate
# (4 with Mutilate), Mutilate to build (Sinister Strike before it is learned), pooling for Slice and Dice when it is
# about to fall; Kick at tier 1, Expose Armor (a setting) at tier 2; Stealth and the poisons before combat (after
# wowsims/forever's Rogue APL, reference only).

actions.precombat=instant_poison,use_off_gcd=1,if=settings.poisons&!buff.main_hand_enchant.up
actions.precombat+=/deadly_poison,use_off_gcd=1,if=settings.poisons&!buff.off_hand_enchant.up
actions.precombat+=/stealth,use_off_gcd=1,if=!buff.stealth.up
actions=kick,focus=1
actions+=/expose_armor,focus=2,if=expose_due&combo_points.current>=5
actions+=/ambush,if=stealthed.all&settings.ambush_opener&combo_points.current<5
actions+=/garrote,if=stealthed.all&!settings.ambush_opener&combo_points.current<5&!debuff.garrote.up&(boss|settings.trash_dots)
actions+=/vanish,use_off_gcd=1,if=settings.vanish&!stealthed.all&combo_points.current<5&buff.slice_and_dice.remains>2&(settings.ambush_opener&energy.current>=action.ambush.cost|!settings.ambush_opener&!debuff.garrote.up&energy.current>=action.garrote.cost&(boss|settings.trash_dots))
actions+=/thistle_tea,if=energy.current<=15
actions+=/slice_and_dice,focus=1,if=!buff.slice_and_dice.up&combo_points.current>=1&!expose_due
actions+=/venom,if=!buff.venom.up&combo_points.current>=3&!expose_due
actions+=/cold_blood,use_off_gcd=1,if=combo_points.current>=5&buff.slice_and_dice.remains>2&energy.current>=action.eviscerate.cost
actions+=/eviscerate,if=(combo_points.current>=5|combo_points.current>=4&action.mutilate.known|combo_points.current>=4&buff.slice_and_dice.remains<=6&buff.slice_and_dice.remains>2)&!expose_due
actions+=/mutilate,if=combo_points.current<5&(buff.slice_and_dice.remains>2|combo_points.current<1|energy.current>=75|expose_due)
actions+=/sinister_strike,if=!action.mutilate.known&combo_points.current<5&(buff.slice_and_dice.remains>2|combo_points.current<1|energy.current>=75|expose_due)
