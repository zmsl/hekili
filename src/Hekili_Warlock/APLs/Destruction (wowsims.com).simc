# Omitted: multi_target_dot_logic #2: dropped the unresolved aura 1225228 (its branch only)
# Omitted: multi_target_dot_logic #3: changeTarget
# Omitted: multi_target_dot_logic #5: changeTarget
# Omitted: multi_target_dot_logic #7: changeTarget
# Omitted: multi_target_dot_logic #8: changeTarget
# Omitted: cooldowns #1: item 249469
# Omitted: cooldowns #2: item 250937

actions.precombat=soul_fire
actions.precombat+=/immolate,if=!debuff.immolate.up
actions=use_items,use_off_gcd=1
actions+=/demonic_rune,use_off_gcd=1
actions+=/major_mana_potion,use_off_gcd=1
actions+=/call_action_list,name=single_multi_target_curse_logic
actions+=/hellfire,if=active_enemies>=3&toggle.movement&(active_enemies>=3&target.outside5)
actions+=/bane_of_doom,focus=2,if=fight_remains>debuff.bane_of_doom.duration
actions+=/call_action_list,name=single_target_dot_logic,if=active_enemies=1
actions+=/call_action_list,name=multi_target_dot_logic,if=active_enemies>1
actions+=/conflagrate,if=((action.immolate.known&debuff.immolate.up)|!buff.shadow_and_flame_shadow.up)
actions+=/shadowburn
actions+=/call_action_list,name=cooldowns,if=((action.bane_of_doom.known&((!action.bane_of_doom.known|((fight_remains-5)/debuff.bane_of_doom.duration)<1)&(!action.bane_of_doom.known|!debuff.bane_of_doom.up)))|((action.bane_of_doom.known&debuff.bane_of_doom.up)|(active_enemies>=3&target.within5)))
actions+=/hellfire,if=active_enemies>=3&target.within5
actions+=/searing_pain,if=(!action.incinerate.known|(action.incinerate.cast+action.incinerate.travel_time)>fight_remains)
actions+=/death_coil,if=(!action.searing_pain.known|action.searing_pain.cast>fight_remains)
actions+=/life_tap,if=(mana.pct_lo<35&fight_remains>60)
actions+=/immolate,focus=2,if=(!action.incinerate.known|debuff.immolate.remains<action.incinerate.cast)
actions+=/incinerate
actions+=/life_tap
actions.single_multi_target_curse_logic=curse_of_the_elements,focus=2,if=settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.single_multi_target_curse_logic+=/curse_of_recklessness,focus=2,if=settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.single_multi_target_curse_logic+=/curse_of_weakness,focus=2,if=settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up))&!(settings.assigned_curse='nocurse'))
actions.multi_target_dot_logic=amplify_curse,use_off_gcd=1,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&(!action.bane_of_doom.known|((action.bane_of_doom.known&!cooldown.bane_of_doom.ready)|(action.bane_of_doom.known&fight_remains<debuff.bane_of_doom.duration)))&(!action.bane_of_agony.known|!debuff.bane_of_agony.up)&active_enemies<5)
actions.multi_target_dot_logic+=/bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&active_enemies<5)
actions.multi_target_dot_logic+=/immolate,focus=2,if=(!debuff.immolate.up&fight_remains>debuff.immolate.duration&(!(active_enemies>=3)|target.outside5))
actions.multi_target_dot_logic+=/corruption,focus=2,if=(!debuff.corruption.up&fight_remains>debuff.corruption.duration&(!(active_enemies>=3)|target.outside5))
actions.single_target_dot_logic=amplify_curse,use_off_gcd=1,if=(!(action.bane_of_doom.known|action.bane_of_agony.known)|((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&(!action.bane_of_doom.known|((action.bane_of_doom.known&!cooldown.bane_of_doom.ready)|(action.bane_of_doom.known&fight_remains<debuff.bane_of_doom.duration)))&(!action.bane_of_agony.known|!debuff.bane_of_agony.up)&(!action.bane_of_agony.known|fight_remains>debuff.bane_of_agony.duration)))
actions.single_target_dot_logic+=/bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&fight_remains>debuff.bane_of_agony.duration)
actions.single_target_dot_logic+=/immolate,focus=2,if=(!debuff.immolate.up&fight_remains>debuff.immolate.duration)
actions.single_target_dot_logic+=/corruption,focus=2,if=(!debuff.corruption.up&fight_remains>debuff.corruption.duration)
actions.cooldowns=eureka,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<8)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/blood_fury,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/berserking,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/immolate,focus=2,if=((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)&active_enemies=1&(!action.incinerate.known|debuff.immolate.remains<action.incinerate.cast))
actions.cooldowns+=/incinerate,if=((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)&active_enemies=1)
actions.cooldowns+=/life_tap,if=((!action.bane_of_doom.known|((action.bane_of_doom.known&debuff.bane_of_doom.remains<22)|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))&(mana.lo<2600&fight_remains>60))
