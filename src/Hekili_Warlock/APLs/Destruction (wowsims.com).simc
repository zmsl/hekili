# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warlock_destruction.lua: edit that recipe, not this file.
# Setting assigned_curse (choice of curseOptions: elements, nocurse, recklessness, weakness), default elements in game and in the harness.
# Omitted: default #1: autocastOtherCooldowns: unmapped item 18588
# Omitted: boosts #2: item 250937

actions=use_items,use_off_gcd=1
actions+=/demonic_rune,use_off_gcd=1
actions+=/call_action_list,name=boosts,if=((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.up)&(!action.bane_of_doom.known|debuff.bane_of_doom.remains<=14)))|((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&fight_remains<60))
actions+=/bane_of_doom,focus=2,if=(!debuff.bane_of_doom.up&fight_remains>=60)
actions+=/bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&fight_remains<60)
actions+=/curse_of_the_elements,focus=2,if=settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/curse_of_recklessness,focus=2,if=settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/curse_of_weakness,focus=2,if=settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/immolate,focus=2,if=!debuff.immolate.up
actions+=/corruption,focus=2,if=!debuff.corruption.up
actions+=/conflagrate,if=(!action.immolate.known|debuff.immolate.up)
actions+=/shadowburn
actions+=/incinerate
actions+=/life_tap
actions.boosts=blood_fury,use_off_gcd=1
