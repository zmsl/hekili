# SM Ruin (wowsims.com): the wowsims/forever default APL for SM Ruin (ui/specs/warlock/dps/builds/sm_ruin.build.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/warlock_sm_ruin.lua: edit that recipe, not this file.
# Setting death_coil_defensive_health (player health threshold, percent), default 35.
# Setting healing_potion_health (player health threshold, percent), default 25.
# Setting healthstone_health (player health threshold, percent), default 30.
# Setting assigned_curse (choice of curseOptions: elements, nocurse, recklessness, weakness), default elements in game and in the harness.
# Deviation: default #4: remainingTime is the target's time to die on this line: its value is lost if this target dies first (owner rule, L1902).
# Omitted: default #3: hidden
# Omitted: default #6: spellExpectedDpet
# Omitted: default #7: spellExpectedDpet
# Omitted: default #8: spellExpectedDpet
# Omitted: default #9: spellExpectedDpet
# Omitted: default #10: spellExpectedDpet

actions=death_coil_defensive,if=health.known&health.pct<=settings.death_coil_defensive_health
actions+=/healthstone,use_off_gcd=1,if=health.known&health.pct<=settings.healthstone_health
actions+=/healing_potion,use_off_gcd=1,if=health.known&health.pct<=settings.healing_potion_health
actions+=/eureka,use_off_gcd=1
actions+=/blood_fury,use_off_gcd=1
actions+=/berserking,use_off_gcd=1
actions+=/use_items,use_off_gcd=1
actions+=/demonic_rune,use_off_gcd=1
actions+=/major_mana_potion,use_off_gcd=1
actions+=/curse_of_the_elements,focus=2,if=settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/curse_of_recklessness,focus=2,if=settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/curse_of_weakness,focus=2,if=settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions+=/bane_of_doom,focus=2,if=target.time_to_die>=60
actions+=/shadow_bolt,focus=1,if=buff.shadow_trance.up
actions+=/corruption,focus=2,if=debuff.corruption.remains<=action.corruption.cast
actions+=/siphon_life,focus=2,if=debuff.siphon_life.remains<=action.siphon_life.cast
actions+=/immolate,focus=2,if=debuff.immolate.remains<=action.immolate.cast
actions+=/life_tap,if=(mana.pct_lo<30&fight_remains>60)
actions+=/shadow_bolt
actions+=/life_tap,if=!action.shadow_bolt.known|mana.lo<action.shadow_bolt.cost
