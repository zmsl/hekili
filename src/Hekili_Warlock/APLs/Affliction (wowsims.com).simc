actions.precombat=shadow_bolt
actions=berserking,use_off_gcd=1
actions+=/use_items,use_off_gcd=1
actions+=/demonic_rune,use_off_gcd=1
actions+=/major_mana_potion,use_off_gcd=1
actions+=/call_action_list,name=single_multi_target_curse_logic
actions+=/bane_of_doom,if=fight_remains>debuff.bane_of_doom.duration
actions+=/call_action_list,name=single_target_dot_logic,if=active_enemies=1
actions+=/call_action_list,name=multi_target_dot_logic,if=active_enemies>1
actions+=/shadow_bolt,focus=2,if=buff.shadow_trance.up
actions+=/shadow_bolt,focus=1,if=buff.shadow_trance.up
actions+=/call_action_list,name=cooldowns,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|((fight_remains-5)/debuff.bane_of_doom.duration)<1)&(!action.bane_of_doom.known|!debuff.bane_of_doom.up)))|(action.bane_of_doom.known&debuff.bane_of_doom.up)))
actions+=/death_coil,if=(!action.shadow_bolt.known|(action.shadow_bolt.cast+action.shadow_bolt.travel_time)>fight_remains)
actions+=/life_tap,if=(mana.pct_lo<30&fight_remains>60)
actions+=/wrack
actions+=/life_tap
actions.single_multi_target_curse_logic=curse_of_the_elements,focus=2,if=settings.assigned_curse='elements'&(!((settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions.single_multi_target_curse_logic+=/curse_of_recklessness,focus=2,if=settings.assigned_curse='recklessness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(action.curse_of_weakness.known&settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions.single_multi_target_curse_logic+=/curse_of_weakness,focus=2,if=settings.assigned_curse='weakness'&(!((action.curse_of_the_elements.known&settings.assigned_curse='elements'&debuff.curse_of_the_elements.up)|(action.curse_of_recklessness.known&settings.assigned_curse='recklessness'&debuff.curse_of_recklessness.up)|(settings.assigned_curse='weakness'&debuff.curse_of_weakness.up)))
actions.multi_target_dot_logic=amplify_curse,use_off_gcd=1,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&(!action.bane_of_doom.known|((action.bane_of_doom.known&!cooldown.bane_of_doom.ready)|(action.bane_of_doom.known&fight_remains<debuff.bane_of_doom.duration)))&(!action.bane_of_agony.known|!debuff.bane_of_agony.up)&active_enemies<5)
actions.multi_target_dot_logic+=/bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&active_enemies<5)
actions.multi_target_dot_logic+=/corruption,focus=2,if=(!debuff.corruption.up&fight_remains>debuff.corruption.duration&(!(active_enemies>=3)|target.outside5))
actions.single_target_dot_logic=amplify_curse,use_off_gcd=1,if=(!(action.bane_of_doom.known|action.bane_of_agony.known)|((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&(!action.bane_of_doom.known|((action.bane_of_doom.known&!cooldown.bane_of_doom.ready)|(action.bane_of_doom.known&fight_remains<debuff.bane_of_doom.duration)))&(!action.bane_of_agony.known|!debuff.bane_of_agony.up)))
actions.single_target_dot_logic+=/bane_of_agony,focus=2,if=((!action.bane_of_doom.known|!debuff.bane_of_doom.up)&!debuff.bane_of_agony.up&fight_remains>12)
actions.single_target_dot_logic+=/corruption,focus=2,if=(!debuff.corruption.up&fight_remains>9)
actions.single_target_dot_logic+=/siphon_life,focus=2,if=(!debuff.siphon_life.up&fight_remains>debuff.siphon_life.duration&!debuff.shadow_vulnerability.up&(!action.blood_fury.known|!buff.blood_fury.up)&(!action.wrack.known|!action.wrack.channeling))
actions.cooldowns=eureka,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<8)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/blood_fury,use_off_gcd=1,if=(!action.bane_of_doom.known|((action.bane_of_doom.known&((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)))|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))
actions.cooldowns+=/wrack,if=((!action.bane_of_doom.known|debuff.bane_of_doom.remains<15)&(!action.bane_of_doom.known|debuff.bane_of_doom.up)&active_enemies=1)
actions.cooldowns+=/life_tap,if=((!action.bane_of_doom.known|((action.bane_of_doom.known&debuff.bane_of_doom.remains<22)|(action.bane_of_doom.known&!debuff.bane_of_doom.up)))&(mana.lo<1800&fight_remains>60))
