# Arcane (wowsims.com): the wowsims/forever default APL for Arcane (ui/specs/mage/dps/apls/arcane.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e5a9cd2a2dfc.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_arcane.lua: edit that recipe, not this file.
# Deviation: precombat #1: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.
# Deviation: precombat #1: the pre-pull time uses the kit's unhasted GCD (1 s off the GCD, wowsims's floor); wowsims uses the hasted GCD.
# Deviation: precombat #2: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.

actions.precombat=read_ley_line
actions.precombat+=/arcane_wrath
actions=call_action_list,name=evocation,if=mana.pct_lo<=10
actions+=/eureka,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/blood_fury,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/berserking,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/use_items,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/arcane_power,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/mana_gem,use_off_gcd=1,if=(buff.missile_barrage.up|(action.arcane_wrath.known&cooldown.arcane_wrath.ready))
actions+=/arcane_missiles,focus=1,if=buff.missile_barrage.up
actions+=/presence_of_mind,use_off_gcd=1,if=(!action.arcane_wrath.known|cooldown.arcane_wrath.ready)
actions+=/arcane_wrath,if=((action.presence_of_mind.known&prev.1.presence_of_mind)|(!action.presence_of_mind.known&(!action.arcane_wrath.known|cooldown.arcane_wrath.ready)))&(!action.arcane_wrath.known|cooldown.arcane_wrath.ready)
actions+=/arcane_wrath
actions+=/fire_blast
actions+=/arcane_blast
actions+=/frostbolt,if=!talent.arcane_instability.enabled
actions.evocation=read_ley_line,if=(!buff.energized.up&action.read_ley_line.known)
actions.evocation+=/evocation,if=((action.read_ley_line.known&prev.1.read_ley_line)|(!action.read_ley_line.known&(!buff.energized.up&action.read_ley_line.known)))&!buff.energized.up
actions.evocation+=/evocation,if=(!action.read_ley_line.known|(action.read_ley_line.known&!cooldown.read_ley_line.ready)|buff.energized.up)
