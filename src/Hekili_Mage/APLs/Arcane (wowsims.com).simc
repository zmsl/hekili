# Arcane (wowsims.com): the wowsims/forever default APL for Arcane (ui/specs/mage/dps/apls/arcane.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_arcane.lua: edit that recipe, not this file.

actions=call_action_list,name=evocation,if=mana.pct<=10
actions+=/read_ley_line,if=action.read_ley_line.known
actions+=/use_items,use_off_gcd=1
actions+=/presence_of_mind,use_off_gcd=1
actions+=/arcane_power,use_off_gcd=1
actions+=/mana_gem,use_off_gcd=1
actions+=/arcane_missiles,focus=1,if=buff.missile_barrage.up
actions+=/arcane_wrath
actions+=/arcane_blast,if=(buff.arcane_blast.remains<action.arcane_blast.cast|(buff.arcane_blast.stack<4&mana.current>=5000)|(buff.arcane_blast.stack<3&mana.current>=4000)|buff.arcane_blast.stack<2)
actions+=/frostbolt
actions.evocation=read_ley_line,if=(!buff.energized.up&action.read_ley_line.known)
actions.evocation+=/evocation
