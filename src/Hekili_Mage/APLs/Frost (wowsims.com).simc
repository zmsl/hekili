# Frost (wowsims.com): the wowsims/forever default APL for Frost (ui/specs/mage/dps/apls/frost.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e5a9cd2a2dfc.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_frost.lua: edit that recipe, not this file.
# Deviation: precombat #1: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.
# Deviation: precombat #1: the pre-pull time uses the kit's unhasted GCD (1 s off the GCD, wowsims's floor); wowsims uses the hasted GCD.
# Deviation: precombat #2: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.
# Omitted: precombat #3: doAtValue not a constant

actions.precombat=ice_barrier,if=!buff.ice_barrier.up
actions.precombat+=/frostbolt
actions=call_action_list,name=mana_tools,if=mana.pct_lo<=5
actions+=/eureka,use_off_gcd=1,if=buff.fingers_of_frost.up
actions+=/blood_fury,use_off_gcd=1,if=buff.fingers_of_frost.up
actions+=/berserking,use_off_gcd=1,if=buff.fingers_of_frost.up
actions+=/use_items,use_off_gcd=1,if=buff.fingers_of_frost.up
actions+=/mana_gem,use_off_gcd=1,if=buff.fingers_of_frost.up
actions+=/call_action_list,name=aoe,if=active_enemies>=3
actions+=/cold_snap,use_off_gcd=1,if=(!action.cone_of_cold.known|cooldown.cone_of_cold.remains>=7)
actions+=/cone_of_cold,focus=1,if=debuff.winters_chill.stack=5
actions+=/ice_lance,focus=1,if=(buff.fingers_of_frost.stack=1&(!action.frostbolt.known|action.frostbolt.executing))
actions+=/ice_barrier,focus=2,if=buff.frigid_power.remains<=3
actions+=/frostbolt
actions.mana_tools=read_ley_line
actions.mana_tools+=/evocation
actions.aoe=cone_of_cold,focus=1,if=buff.fingers_of_frost.stack>=1
actions.aoe+=/ice_lance,focus=1,if=buff.fingers_of_frost.stack>=1
actions.aoe+=/cold_snap,use_off_gcd=1,if=(!action.cone_of_cold.known|cooldown.cone_of_cold.remains>=5)
actions.aoe+=/ice_barrier,focus=2,if=!buff.ice_barrier.up
actions.aoe+=/blizzard
