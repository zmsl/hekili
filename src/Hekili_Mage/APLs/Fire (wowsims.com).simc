# Fire (wowsims.com): the wowsims/forever default APL for Fire (ui/specs/mage/dps/apls/deepFire.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_fire.lua: edit that recipe, not this file.

actions=call_action_list,name=evocation,if=mana.pct<=10
actions+=/read_ley_line,if=action.read_ley_line.known
actions+=/scorch,focus=2,if=(debuff.fire_vulnerability.stack<5|debuff.fire_vulnerability.remains<5)
actions+=/use_items,use_off_gcd=1
actions+=/combustion,use_off_gcd=1
actions+=/mana_gem,use_off_gcd=1
actions+=/pyroblast,focus=1,if=buff.heating_up.stack=3
actions+=/fire_blast
actions+=/arcane_missiles,focus=1,if=buff.missile_barrage.up
actions+=/fireball
actions.evocation=read_ley_line,if=(!buff.energized.up&action.read_ley_line.known)
actions.evocation+=/evocation
