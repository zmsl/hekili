# Fire (wowsims.com): the wowsims/forever default APL for Fire (ui/specs/mage/dps/apls/deepFire.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at e5a9cd2a2dfc.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_fire.lua: edit that recipe, not this file.
# Deviation: precombat #1: the pre-pull time uses the kit's base cast time; wowsims uses the hasted cast.

actions.precombat=pyroblast
actions=call_action_list,name=evocation,if=(!action.pyroblast.known|mana.lo<action.pyroblast.cost)
actions+=/pyroblast,focus=1,if=(buff.heating_up.stack=3&!action.pyroblast.executing)
actions+=/fire_blast
actions+=/scorch,focus=2,if=((debuff.fire_vulnerability.stack<5|debuff.fire_vulnerability.remains<5)&(debuff.fire_vulnerability.stack<4|!action.scorch.executing))
actions+=/eureka,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/blood_fury,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/berserking,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/use_items,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/combustion,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/mana_gem,use_off_gcd=1,if=debuff.fire_vulnerability.stack=5
actions+=/arcane_blast,if=((!buff.arcane_blast.up|buff.arcane_blast.remains<action.arcane_blast.cast)&!action.arcane_blast.executing)
actions+=/arcane_missiles,focus=1,if=buff.missile_barrage.up
actions+=/fireball,if=(!action.fire_blast.known|cooldown.fire_blast.remains>=action.fireball.cast)
actions+=/scorch
actions.evocation=read_ley_line,if=(!buff.energized.up&action.read_ley_line.known)
actions.evocation+=/evocation,if=((action.read_ley_line.known&prev.1.read_ley_line)|(!action.read_ley_line.known&(!buff.energized.up&action.read_ley_line.known)))&!buff.energized.up
actions.evocation+=/evocation,if=(!action.read_ley_line.known|(action.read_ley_line.known&!cooldown.read_ley_line.ready)|buff.energized.up)
