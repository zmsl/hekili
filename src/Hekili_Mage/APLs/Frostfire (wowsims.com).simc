# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/mage_frostfire.lua: edit that recipe, not this file.
# Omitted: default #2: spell 1259705
# Omitted: evocation #1: spell 1259705

actions=call_action_list,name=evocation,if=mana.pct<=10
actions+=/scorch,focus=2,if=(debuff.fire_vulnerability.stack<5|debuff.fire_vulnerability.remains<5)
actions+=/use_items,use_off_gcd=1
actions+=/mana_gem,use_off_gcd=1
actions+=/pyroblast,focus=1,if=buff.heating_up.stack=3
actions+=/fire_blast,focus=1,if=buff.fingers_of_frost.stack<2
actions+=/frostfire_bolt
actions.evocation=evocation,focus=2
