# Balance (wowsims.com): the wowsims/forever default APL for Balance (ui/specs/druid/balance/apls/default.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at ab0f00e4fc83.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/druid_balance.lua: edit that recipe, not this file.
# Setting barkskin_health (player health threshold, percent), default 50.
# Setting healing_potion_health (player health threshold, percent), default 25.
# Setting healthstone_health (player health threshold, percent), default 30.
# Omitted: default #1: autocastOtherCooldowns: unmapped item 272439

actions.precombat=moonkin_form,if=!buff.moonkin_form.up
actions.precombat+=/wrath,if=active_enemies<4
actions=moonkin_form,if=!buff.moonkin_form.up
actions+=/barkskin,if=health.known&health.pct<=settings.barkskin_health
actions+=/healthstone,use_off_gcd=1,if=health.known&health.pct<=settings.healthstone_health
actions+=/healing_potion,use_off_gcd=1,if=health.known&health.pct<=settings.healing_potion_health
actions+=/elunes_light,use_off_gcd=1
actions+=/weakness_analyzer,use_off_gcd=1
actions+=/innervate,if=mana.pct_lo<40&fight_remains>30
actions+=/moonfire,focus=2,if=!debuff.moonfire.up
actions+=/insect_swarm,focus=2,if=!debuff.insect_swarm.up
actions+=/hurricane,if=active_enemies>=4
actions+=/starfire,focus=1,if=((!talent.eclipse.enabled|buff.eclipse.up)&((talent.eclipse.enabled&buff.eclipse.stack>1)|!action.starfire.executing))
actions+=/wrath
