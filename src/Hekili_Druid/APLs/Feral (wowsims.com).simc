actions+=/rip,focus=2,if=((!action.cat_form.known|buff.cat_form.up)&((combo_points.current>=4&(!(talent.primal_fury.rank=0|(talent.primal_fury.rank>=2&talent.shifting_power.enabled))|combo_points.current>=5|!((!action.shred.known|action.shred.ready)&fight_remains>=(8+1)&(!action.shred.known|(energy.lo+10)>=(action.shred.cost+action.rip.cost)))))&!debuff.rip.up&fight_remains>=8))&(toggle.movement&target.outside5|target.within5)
