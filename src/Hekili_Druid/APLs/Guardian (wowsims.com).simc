actions+=/enrage,use_off_gcd=1,if=(action.enrage.known&gcd.remains<=0&(((action.primal_bite.known&(!action.primal_bite.known|cooldown.primal_bite.ready))&(!action.primal_bite.known|rage.lo<action.primal_bite.cost))|(!(action.primal_bite.known&(!action.primal_bite.known|cooldown.primal_bite.ready))&(!action.lacerate.known|rage.lo<action.lacerate.cost))))&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/faerie_fire,if=(action.faerie_fire.known&debuff.faerie_fire.remains<=0)&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/lacerate,focus=2,if=((debuff.lacerate.up&debuff.lacerate.stack>=5)&debuff.lacerate.remains<=3)&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/demoralizing_roar,focus=2,if=settings.maintain_demoralizing_roar&(!(!(debuff.demoralizing_roar.remains<=0))&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5))
actions+=/primal_bite,if=action.primal_bite.known&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/swipe_bear,if=(active_enemies>=2&druid_bleed_active)&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/lacerate,focus=2,if=(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/maul,use_off_gcd=1,focus=1,if=(rage.lo>=20&(!action.primal_bite.known|(action.primal_bite.known&cooldown.primal_bite.remains>1.5)|(action.primal_bite.known&(rage.lo-action.maul.cost)>=action.primal_bite.cost)))&(toggle.movement&(target.outside5&(!action.feral_charge.known|cooldown.feral_charge.ready))|target.within5)
actions+=/maul,use_off_gcd=1,focus=2,if=!action.primal_bite.known
