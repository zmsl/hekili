actions.precombat=bear_form,if=!buff.bear_form.up
actions.precombat+=/bear_form,if=!buff.bear_form.up&(talent.furor.enabled&rage.lo<10)
actions.precombat+=/enrage,use_off_gcd=1
actions=bear_form,if=!buff.bear_form.up
