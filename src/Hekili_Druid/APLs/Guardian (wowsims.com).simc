actions.precombat=bear_form,if=!buff.bear_form.up
actions.precombat+=/enrage,use_off_gcd=1
actions=bear_form,if=!buff.bear_form.up
actions+=/feral_charge,use_off_gcd=1,if=target.outside5
actions+=/elunes_light,use_off_gcd=1,if=action.elunes_light.known&(toggle.movement&target.outside5|target.within5)
actions+=/enrage,use_off_gcd=1,if=(action.lacerate.known&gcd.remains<=0&(!action.lacerate.known|rage.lo<action.lacerate.cost))&(toggle.movement&target.outside5|target.within5)
actions+=/faerie_fire,if=(action.faerie_fire.known&debuff.faerie_fire.remains<=0)&(toggle.movement&target.outside5|target.within5)
actions+=/demoralizing_roar,focus=2,if=settings.maintain_demoralizing_roar&(!(!(debuff.demoralizing_roar.remains<=0))&(toggle.movement&target.outside5|target.within5))
actions+=/primal_bite,if=action.primal_bite.known&(toggle.movement&target.outside5|target.within5)
actions+=/lacerate,focus=2,if=(toggle.movement&target.outside5|target.within5)
actions+=/maul,use_off_gcd=1,focus=2,if=(rage.lo>=20&(!action.primal_bite.known|(action.primal_bite.known&cooldown.primal_bite.remains>1.5)|(action.primal_bite.known&(rage.lo-action.maul.cost)>=action.primal_bite.cost)))&(toggle.movement&target.outside5|target.within5)
actions+=/maul,use_off_gcd=1,focus=2,if=!action.primal_bite.known
