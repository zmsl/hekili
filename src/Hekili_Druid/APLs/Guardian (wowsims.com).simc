# Guardian (wowsims.com): the wowsims/forever default APL for Guardian (ui/specs/druid/feralbear/apls/default.apl.json), translated to this addon's keys.
# Data: wowsims/forever (MIT, https://github.com/wowsims/forever) at d33930d04030.

# Generated by `make wowsims-packs` (tools/wowsims/apl.lua) from tools/wowsims/specs/druid_guardian.lua: edit that recipe, not this file.
# Omitted: cooldowns #3: autocastOtherCooldowns: none in the log

actions=call_action_list,name=cooldowns
actions+=/frenzied_regeneration,if=health.pct<20
actions+=/call_action_list,name=keep_up
actions+=/call_action_list,name=damage
actions+=/maul,use_off_gcd=1,if=rage.current>=20
actions.cooldowns=berserk,use_off_gcd=1,if=(action.berserk.known&cooldown.berserk.ready&(!action.demoralizing_roar.known|debuff.demoralizing_roar.up)&(!action.primal_bite.known|cooldown.primal_bite.remains>=4))
actions.cooldowns+=/elunes_light,use_off_gcd=1,if=((action.berserk.known&buff.berserk.up)|!action.berserk.known)
actions.keep_up=lacerate,focus=2,if=(((debuff.lacerate.up&debuff.lacerate.stack>=5)&debuff.lacerate.remains<=1.5)&!(action.berserk.known&(!action.berserk.known|cooldown.berserk.ready)&(!action.demoralizing_roar.known|debuff.demoralizing_roar.up)&(!action.primal_bite.known|cooldown.primal_bite.remains>=4)))
actions.keep_up+=/demoralizing_roar,if=!debuff.demoralizing_roar.up
actions.damage=primal_bite
actions.damage+=/lacerate,focus=2,if=!(action.berserk.known&(!action.berserk.known|cooldown.berserk.ready)&(!action.demoralizing_roar.known|debuff.demoralizing_roar.up)&(!action.primal_bite.known|cooldown.primal_bite.remains>=4))
