actions.precombat=hunters_mark,if=!debuff.hunters_mark.up
actions.precombat+=/aspect_of_the_beast,if=!buff.aspect_of_the_beast.up
actions=elunes_light,use_off_gcd=1,if=time>=5
actions+=/blood_fury,use_off_gcd=1,if=time>=5
actions+=/berserking,use_off_gcd=1,if=time>=5
actions+=/major_mana_potion,use_off_gcd=1,if=time>=5
actions+=/demonic_rune,use_off_gcd=1,if=time>=5
actions+=/rapid_fire,use_off_gcd=1,if=time>=5
actions+=/raptor_strike,use_off_gcd=1,focus=1,if=target.within5
actions+=/hunters_mark,focus=2,if=!debuff.hunters_mark.up
actions+=/raptor_strike,use_off_gcd=1,focus=1,if=toggle.movement&(target.outside5&(!((!action.arcane_shot.known|action.arcane_shot.in_range)&((ranged_remains<=0|ranged_remains>=(ranged_speed-(ranged_speed-ranged_remains)))|ranged_remains>ranged_speed-0))))
actions+=/mongoose_bite,if=toggle.movement&(target.outside5&(!((!action.arcane_shot.known|action.arcane_shot.in_range)&((ranged_remains<=0|ranged_remains>=(ranged_speed-(ranged_speed-ranged_remains)))|ranged_remains>ranged_speed-0))))
actions+=/strider_kick,if=toggle.movement&(target.outside5&(!((!action.arcane_shot.known|action.arcane_shot.in_range)&((ranged_remains<=0|ranged_remains>=(ranged_speed-(ranged_speed-ranged_remains)))|ranged_remains>ranged_speed-0))))
actions+=/wing_clip,if=toggle.movement&(target.outside5&(!((!action.arcane_shot.known|action.arcane_shot.in_range)&((ranged_remains<=0|ranged_remains>=(ranged_speed-(ranged_speed-ranged_remains)))|ranged_remains>ranged_speed-0))))
actions+=/call_action_list,name=walk_in,if=target.outside5
actions+=/mongoose_bite,if=target.within5
actions+=/strider_kick,if=target.within5
actions+=/immolation_trap
actions+=/summon_hawk
actions+=/wing_clip,if=target.within5
actions.walk_in=serpent_sting,focus=1,if=!debuff.serpent_sting.up
actions.walk_in+=/arcane_shot
actions.walk_in+=/multi_shot
