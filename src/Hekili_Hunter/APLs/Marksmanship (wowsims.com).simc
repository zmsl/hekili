actions.precombat=hunters_mark,if=!debuff.hunters_mark.up
actions.precombat+=/aspect_of_the_hawk,if=!buff.aspect_of_the_hawk.up
actions=blood_fury,use_off_gcd=1,if=time>=5
actions+=/rapid_fire,use_off_gcd=1,if=time>=5
actions+=/open_window,name=weave,if=ranged_remains>ranged_speed-0.1&mainhand_remains<=(1*((11-5)/7))
actions+=/raptor_strike,use_off_gcd=1,focus=1,if=(toggle.movement&((mainhand_remains<=(1*((11-5)/7))&ranged_remains>=((1*((11-5)/7))+max(0,0.2)))&window.weave.up)|target.within5)
actions+=/hunters_mark,focus=2,if=!debuff.hunters_mark.up
actions+=/mongoose_bite,if=(toggle.movement&((mainhand_remains<=(1*((11-5)/7))&ranged_remains>=((1*((11-5)/7))+max(0,0.2)))&window.weave.up)|target.within5)
actions+=/strider_kick,if=(toggle.movement&((mainhand_remains<=(1*((11-5)/7))&ranged_remains>=((1*((11-5)/7))+max(0,0.2)))&window.weave.up)|target.within5)
actions+=/immolation_trap,if=(toggle.movement&((mainhand_remains<=(1*((11-5)/7))&ranged_remains>=((1*((11-5)/7))+max(0,0.2)))&window.weave.up)|target.within5)
actions+=/wing_clip,if=(toggle.movement&((mainhand_remains<=(1*((11-5)/7))&ranged_remains>=((1*((11-5)/7))+max(0,0.2)))&window.weave.up)|target.within5)
actions+=/serpent_sting,focus=1,if=!debuff.serpent_sting.up
actions+=/arcane_shot
actions+=/multi_shot,if=(action.multi_shot.cast+(1*((11-5)/7)))<=mainhand_remains
