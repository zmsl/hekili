actions.precombat=hunters_mark,if=!debuff.hunters_mark.up
actions.precombat+=/aspect_of_the_hawk,if=!buff.aspect_of_the_hawk.up
actions=rapid_fire,use_off_gcd=1,if=target.outside5
actions+=/elunes_light,use_off_gcd=1,if=time>=5&target.outside5
actions+=/blood_fury,use_off_gcd=1,if=time>=5&target.outside5
