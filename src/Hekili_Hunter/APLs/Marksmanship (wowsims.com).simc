actions+=/strider_kick,if=target.within5
actions+=/mongoose_bite,if=target.within5
actions+=/immolation_trap,if=target.within5
actions+=/wing_clip,if=(!action.strider_kick.known|(action.strider_kick.known&cooldown.strider_kick.remains>1.5))&target.within5
