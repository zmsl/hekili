actions.precombat+=/mark_of_the_wild,if=!up&!buff.gift_of_the_wild.up
actions.precombat+=/thorns,if=!up
actions.precombat+=/omen_of_clarity,if=!buff.omen_of_clarity.up
actions.precombat+=/cat_form,if=!buff.form.up

actions.prowl+=/pounce,if=combat_mode_solo
actions.prowl+=/ravage

actions.ranged+=/tigers_fury,if=energy.current=100&target.outside5
actions.ranged+=/faerie_fire_feral,if=!buff.prowl.up&debuff.faerie_fire_feral.remains<12&debuff.faerie_fire.remains<12&target.outside2
actions.ranged+=/moonfire,if=!buff.prowl.up&!debuff.moonfire.up&target.outside5&mana.current>=action.moonfire.cost+(buff.bear_form.up&action.bear_form.cost|action.cat_form.cost)

actions.innervate_or_shift+=/innervate,if=settings.innervate_enabled&action.innervate.known&mana.pct<=innervate_threshold&ttd>2
actions.innervate_or_shift+=/best_mana_potion
actions.innervate_or_shift+=/mana_rune
actions.innervate_or_shift+=/cat_form,if=(settings.powershift_enabled&set_bonus.wolfshead=1&talent.furor.rank=5&mana.current>=action.cat_form.cost)

actions+=/use_items,if=!buff.cat_form.up
actions+=/potion,if=!buff.cat_form.up
actions+=/best_mana_potion,if=!buff.form.up&mana.current<action.cat_form.cost
actions+=/mana_rune,if=!buff.form.up&mana.current<action.cat_form.cost
actions+=/cat_form,if=!buff.form.up
actions+=/run_action_list,name=bear,if=buff.bear_form.up
actions+=/call_action_list,name=ranged
actions+=/call_action_list,name=prowl,if=buff.prowl.up
actions+=/run_action_list,name=cat_solo,if=combat_mode_solo
actions+=/run_action_list,name=cat_oom,if=!(settings.powershift_enabled&set_bonus.wolfshead=1&talent.furor.rank=5&mana.current>=action.cat_form.cost)
actions+=/run_action_list,name=cat_ps

actions.bear+=/maul,use_off_gcd=1,if=!buff.maul.up
actions.bear+=/swipe_bear,if=rage.current>60
actions.bear+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up

actions.cat_solo+=/call_action_list,name=innervate_or_shift,if=energy.current<10
actions.cat_solo+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up
actions.cat_solo+=/rip,if=(settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10))
actions.cat_solo+=/mangle_cat,if=energy.current>=63|(energy.current>=15&buff.clearcasting.up)
actions.cat_solo+=/ferocious_bite,if=(settings.bite_enabled&((settings.bite_enabled&debuff.rip.up&debuff.rip.remains>=settings.bite_time)|(settings.bite_enabled&(!settings.rip_enabled|combat_mode_solo)))&combo_points.current>=settings.bite_cp)
actions.cat_solo+=/mangle_cat
actions.cat_solo+=/claw,if=!action.mangle_cat.known

actions.cat_oom+=/rip,if=(settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10))
actions.cat_oom+=/shred,if=energy.current>=63
actions.cat_oom+=/ferocious_bite,if=(settings.bite_enabled&((settings.bite_enabled&debuff.rip.up&debuff.rip.remains>=settings.bite_time)|(settings.bite_enabled&(!settings.rip_enabled|combat_mode_solo)))&combo_points.current>=settings.bite_cp)
actions.cat_oom+=/shred
actions.cat_oom+=/claw,if=!action.shred.known

actions.cat_ps+=/call_action_list,name=innervate_or_shift,if=energy.current<10
actions.cat_ps+=/ravage,if=buff.prowl.up
actions.cat_ps+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up
actions.cat_ps+=/rip,if=((settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10)))
actions.cat_ps+=/call_action_list,name=innervate_or_shift,if=((settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10)))&(energy.time_to_tick>settings.powershift_time)
actions.cat_ps+=/shred,if=!((settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10)))&((settings.bite_enabled&((settings.bite_enabled&debuff.rip.up&debuff.rip.remains>=settings.bite_time)|(settings.bite_enabled&(!settings.rip_enabled|combat_mode_solo)))&combo_points.current>=settings.bite_cp)|(combo_points.current>=settings.bite_cp&(ttd<(10)|(debuff.rip.up&ttd-debuff.rip.remains<(10)))&!(!settings.bite_enabled&!settings.rip_enabled)))&(energy.current>=63|(energy.current>=15&buff.clearcasting.up))
actions.cat_ps+=/ferocious_bite,if=!((settings.rip_enabled&combo_points.current>=settings.rip_cp&!debuff.rip.up&ttd>=(10)))&((settings.bite_enabled&((settings.bite_enabled&debuff.rip.up&debuff.rip.remains>=settings.bite_time)|(settings.bite_enabled&(!settings.rip_enabled|combat_mode_solo)))&combo_points.current>=settings.bite_cp)|(combo_points.current>=settings.bite_cp&(ttd<(10)|(debuff.rip.up&ttd-debuff.rip.remains<(10)))&!(!settings.bite_enabled&!settings.rip_enabled)))&!buff.clearcasting.up
