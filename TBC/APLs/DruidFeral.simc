actions.precombat+=/mark_of_the_wild,if=!up&!buff.gift_of_the_wild.up
actions.precombat+=/thorns,if=!up
actions.precombat+=/omen_of_clarity,if=!buff.omen_of_clarity.up
actions.precombat+=/cat_form,if=!buff.form.up&preferred_form_cat
actions.precombat+=/dire_bear_form,if=!buff.bear_form.up&preferred_form_bear

actions.prowl+=/pounce,if=combat_mode_solo
actions.prowl+=/ravage

actions.ranged+=/tigers_fury,if=energy.current=100&target.outside5
actions.ranged+=/faerie_fire_feral,if=!buff.prowl.up&debuff.faerie_fire_feral.remains<12&debuff.faerie_fire.remains<12&target.outside2
actions.ranged+=/moonfire,if=!buff.prowl.up&!debuff.moonfire.up&target.outside5&mana.current>=action.moonfire.cost+(buff.bear_form.up&action.bear_form.cost|action.cat_form.cost)

actions+=/use_items,if=!buff.cat_form.up
actions+=/cat_form,if=!buff.form.up&preferred_form_cat
actions+=/dire_bear_form,if=!buff.bear_form.up&preferred_form_bear
actions+=/run_action_list,name=bear,if=buff.bear_form.up
actions+=/call_action_list,name=ranged
actions+=/call_action_list,name=prowl,if=buff.prowl.up
actions+=/run_action_list,name=cat_solo,if=combat_mode_solo
actions+=/run_action_list,name=cat_ps

actions.bear+=/maul,use_off_gcd=1,if=!buff.maul.up&rage.current>=50
actions.bear+=/lacerate,if=dot.lacerate.stack=5&dot.lacerate.remains<1.5
actions.bear+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up
actions.bear+=/demoralizing_roar,if=!debuff.ap_reduction.up|debuff.ap_reduction.remains<2
actions.bear+=/mangle_bear,if=rage.current>=20
actions.bear+=/swipe_bear,if=dot.lacerate.stack=5&dot.lacerate.remains>3&stat.attack_power>=settings.bear_swipe_ap
actions.bear+=/lacerate,if=dot.lacerate.stack<5|dot.lacerate.remains<3
actions.bear+=/swipe_bear,if=dot.lacerate.stack=5&dot.lacerate.remains>3

actions.cat_solo+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up
actions.cat_solo+=/potion
actions.cat_solo+=/best_mana_potion,if=mana.deficit>=action.best_mana_potion.max_mana_restored
actions.cat_solo+=/best_mana_rune,if=mana.deficit>=action.best_mana_rune.max_mana_restored
actions.cat_solo+=/innervate,if=!buff.clearcasting.up&(mana.pct<=settings.innervate_mana_pct&mana.current>=action.cat_form.cost|mana.current<action.cat_form.cost*2&mana.current>=action.cat_form.cost)&cooldown.innervate.ready
actions.cat_solo+=/cat_form,if=energy<10&!buff.clearcasting.up
actions.cat_solo+=/rip,if=combo_points>=settings.rip_cp&!dot.rip.ticking&target.time_to_die>=10&(energy>=30|buff.omen_of_clarity.up)
actions.cat_solo+=/rip,if=settings.ripweave&combo_points>=settings.rip_cp&!dot.rip.ticking&energy>=52&target.time_to_die>=10
actions.cat_solo+=/cat_form,if=combo_points>=settings.rip_cp&!dot.rip.ticking&target.time_to_die>=10&energy<30&!buff.clearcasting.up&!buff.omen_of_clarity.up&energy.time_to_next_tick>1
actions.cat_solo+=/mangle_cat,if=energy.current>=63|(energy.current>=15&buff.clearcasting.up)
actions.cat_solo+=/cat_form,if=!debuff.mangle.up&energy<(action.mangle_cat.cost-20)&!buff.clearcasting.up&energy.time_to_next_tick>1
actions.cat_solo+=/ferocious_bite,if=combo_points>=settings.bite_cp&target.time_to_die<10&energy>=35
actions.cat_solo+=/ferocious_bite,if=combo_points>=settings.bite_cp&dot.rip.ticking&(fight_remains-dot.rip.remains)<10&energy>=35
actions.cat_solo+=/mangle_cat
actions.cat_solo+=/cat_form,if=energy<22&!buff.clearcasting.up&energy.time_to_next_tick>1

actions.cat_ps+=/faerie_fire_feral,if=!debuff.faerie_fire.up&!debuff.faerie_fire_feral.up
actions.cat_ps+=/potion
actions.cat_ps+=/best_mana_potion,if=mana.deficit>=action.best_mana_potion.max_mana_restored
actions.cat_ps+=/best_mana_rune,if=mana.deficit>=action.best_mana_rune.max_mana_restored
actions.cat_ps+=/innervate,if=!buff.clearcasting.up&(mana.pct<=settings.innervate_mana_pct&mana.current>=action.cat_form.cost|mana.current<action.cat_form.cost*2&mana.current>=action.cat_form.cost)&cooldown.innervate.ready
actions.cat_ps+=/cat_form,if=energy<10
actions.cat_ps+=/rip,if=combo_points>=settings.rip_cp&!dot.rip.ticking&target.time_to_die>=10&(energy>=30|buff.omen_of_clarity.up)
actions.cat_ps+=/rip,if=settings.ripweave&combo_points>=settings.rip_cp&!dot.rip.ticking&energy>=52&target.time_to_die>=10
actions.cat_ps+=/cat_form,if=combo_points>=settings.rip_cp&!dot.rip.ticking&target.time_to_die>=10&energy<30&!buff.omen_of_clarity.up&energy.time_to_next_tick>1
actions.cat_ps+=/ferocious_bite,if=combo_points>=settings.bite_cp&target.time_to_die<10&energy>=35
actions.cat_ps+=/ferocious_bite,if=combo_points>=settings.bite_cp&dot.rip.ticking&(fight_remains-dot.rip.remains)<10&energy>=35
actions.cat_ps+=/shred,if=settings.biteweave&combo_points>=settings.bite_cp&dot.rip.ticking&energy>=57&!settings.bite_over_rip
actions.cat_ps+=/ferocious_bite,if=settings.biteweave&combo_points>=settings.bite_cp&dot.rip.ticking&energy>=35&!settings.bite_over_rip
actions.cat_ps+=/shred,if=settings.bite_over_rip&combo_points>=settings.bite_cp&energy>=57
actions.cat_ps+=/ferocious_bite,if=settings.bite_over_rip&combo_points>=settings.bite_cp&energy>=35
actions.cat_ps+=/mangle_cat,if=!debuff.mangle.up&(energy>=action.mangle_cat.cost|buff.omen_of_clarity.up)
actions.cat_ps+=/cat_form,if=!debuff.mangle.up&energy<(action.mangle_cat.cost-20)&energy.time_to_next_tick>1
actions.cat_ps+=/ferocious_bite,if=settings.rake_trick&combo_points>=2&energy>=35&energy<=39&!buff.omen_of_clarity.up&energy.time_to_next_tick>1
actions.cat_ps+=/rake,if=settings.rake_trick&!dot.rake.ticking&energy>=35&energy<action.mangle_cat.cost&!buff.omen_of_clarity.up&energy.time_to_next_tick>1
actions.cat_ps+=/mangle_cat,if=settings.mangle_trick&energy>=(2*action.mangle_cat.cost-20)&energy<(22+action.mangle_cat.cost)&energy.time_to_next_tick<=1
actions.cat_ps+=/shred,if=energy>=42|buff.omen_of_clarity.up
actions.cat_ps+=/mangle_cat,if=energy>=action.mangle_cat.cost&energy.time_to_next_tick>1
actions.cat_ps+=/cat_form,if=energy<22&energy.time_to_next_tick>1
actions.cat_ps+=/cat_form,if=energy.time_to_next_tick>1