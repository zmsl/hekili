actions.precombat+=/moonkin_form,if=!buff.moonkin_form.up
actions.precombat+=/mark_of_the_wild,if=!buff.mark_of_the_wild.up&!buff.gift_of_the_wild.up

actions+=/use_items
actions+=/potion
actions+=/best_mana_potion,if=mana.deficit>=action.best_mana_potion.max_mana_restored
actions+=/best_mana_rune,if=mana.deficit>=action.best_mana_rune.max_mana_restored
actions+=/innervate,if=mana.pct<=settings.innervate_mana_pct&cooldown.innervate.ready
actions+=/moonkin_form,if=!buff.moonkin_form.up
actions+=/call_action_list,name=aoe,if=active_enemies>1
actions+=/call_action_list,name=st

actions.st+=/faerie_fire,if=!debuff.faerie_fire.up
actions.st+=/moonfire,if=!debuff.moonfire.ticking&(!settings.mana_management|settings.drop_moonfire_mana_pct=0|mana.pct>settings.drop_moonfire_mana_pct)
actions.st+=/insect_swarm,if=!debuff.insect_swarm.ticking&(moving|(settings.mana_management&((settings.add_insect_swarm_mana_pct>0&mana.pct<=settings.add_insect_swarm_mana_pct)|(set_bonus.tier5_balance>=4&settings.drop_moonfire_mana_pct>0&mana.pct<=settings.drop_moonfire_mana_pct))))
actions.st+=/force_of_nature,if=ttd>25
actions.st+=/starfire,label=R6,label_if=settings.mana_management&settings.downrank_starfire_mana_pct>0&mana.pct<=settings.downrank_starfire_mana_pct
actions.st+=/wrath

actions.aoe+=/faerie_fire,if=!debuff.faerie_fire.up
actions.aoe+=/moonfire,if=active_dot.moonfire<3,cycle_targets=1
actions.aoe+=/hurricane
actions.aoe+=/force_of_nature
actions.aoe+=/starfire
actions.aoe+=/wrath
